---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const homeLink = { href: '/', label: 'Home' };
const caseStudiesLink = { href: '/case-studies/', label: 'Case Studies' };
const serviceGroups = [
  { title: 'MEASUREMENT', links: [
    { href: '/services/ga4-gtm-setup/', label: 'GA4 & GTM Setup', detail: 'Web events, data layers and implementation' },
    { href: '/services/server-side-tracking/', label: 'Server-Side Tracking', detail: 'sGTM, first-party collection and routing' },
    { href: '/services/mobile-analytics/', label: 'Mobile Analytics', detail: 'In-app events, funnels and retention' },
  ]},
  { title: 'ATTRIBUTION & PRIVACY', links: [
    { href: '/services/mobile-measurement/', label: 'Mobile Measurement', detail: 'MMP setup, attribution and deep links' },
    { href: '/services/meta-conversions-api/', label: 'Meta Conversions API', detail: 'Browser and server conversion events' },
    { href: '/services/cookie-consent/', label: 'Cookie Consent & CMP', detail: 'Consent Mode and tag behavior' },
  ]},
  { title: 'STRATEGY & REPORTING', links: [
    { href: '/services/measurement-planning/', label: 'Measurement Planning', detail: 'Architecture, flows and implementation plan' },
    { href: '/services/tracking-audit/', label: 'Tracking Audit', detail: 'Technical QA and remediation priorities' },
    { href: '/services/analytics-dashboards/', label: 'Analytics Dashboards', detail: 'KPI reporting and decision support' },
  ]},
];
const serviceLinks = serviceGroups.flatMap((group) => group.links);
const resourceLinks = [
  { href: '/who-its-for/', label: "Who It's For" },
  { href: '/process/', label: 'Process' },
  { href: '/about/', label: 'About' },
];
const active = (href: string) => path === href.replace(/\/$/, '') || (href === '/case-studies/' && path.startsWith('/case-studies/'));
const resourcesActive = resourceLinks.some((link) => active(link.href));
const servicesActive = path === '/services' || path.startsWith('/services/');
---
<nav class="fixed top-0 left-0 right-0 z-50 min-h-16 border-b border-border bg-background/95 backdrop-blur-sm md:min-h-20" aria-label="Primary navigation">
  <div class="container">
    <div class="flex h-16 min-h-16 items-center justify-between md:h-20 md:min-h-20">
      <a href="/" class="flex items-center gap-2" aria-label="Upsight Digital home">
        <img src="/images/logo-nav.webp" alt="Upsight Digital" class="h-8 w-[151px] object-contain" width="151" height="32" loading="eager" fetchpriority="high" decoding="async" />
      </a>

      <div id="desktop-navigation-links" class="hidden items-center gap-8 md:flex">
        <a href={homeLink.href} aria-current={active(homeLink.href) ? 'page' : undefined} class:list={["text-sm font-medium transition-colors hover:text-primary", active(homeLink.href) ? "text-primary" : "text-foreground/80"]}>{homeLink.label}</a>
        <details id="services-menu" class="group relative">
          <summary class:list={["flex cursor-pointer list-none items-center gap-1 text-sm font-medium [&::-webkit-details-marker]:hidden transition-colors hover:text-primary focus-visible:outline-none focus-visible:text-primary", servicesActive ? "text-primary" : "text-foreground/80"]}>
            Services
            <svg class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class="absolute left-0 top-full z-50 pt-2"><div class="w-[760px] rounded-lg border border-border bg-card p-5 shadow-xl"><div class="grid grid-cols-3 gap-4">{serviceGroups.map((group) => <div class="min-w-0"><p class="service-kicker h-8 whitespace-nowrap text-xs leading-4">{group.title}</p><div class="mt-2 grid h-[14.5rem] grid-rows-3 gap-1">{group.links.map((link) => <a href={link.href} class="flex h-full min-w-0 flex-col overflow-hidden rounded p-2 hover:bg-muted focus-visible:bg-muted focus-visible:outline-none"><span class="block text-sm font-semibold leading-5">{link.label}</span><span class="mt-1 block min-h-8 text-xs leading-4 text-muted-foreground">{link.detail}</span></a>)}</div></div>)}</div><a href="/services/" class="mt-3 inline-block text-sm font-semibold text-primary">View all services →</a></div></div>
        </details>

        <a href={caseStudiesLink.href} aria-current={active(caseStudiesLink.href) ? 'page' : undefined} class:list={["text-sm font-medium transition-colors hover:text-primary", active(caseStudiesLink.href) ? "text-primary" : "text-foreground/80"]}>{caseStudiesLink.label}</a>

        <details id="resources-menu" class="group relative">
          <summary
            class:list={["flex cursor-pointer list-none items-center gap-1 text-sm font-medium [&::-webkit-details-marker]:hidden transition-colors hover:text-primary focus-visible:outline-none focus-visible:text-primary", resourcesActive ? "text-primary" : "text-foreground/80"]}
          >
            Resources
            <svg class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class=" absolute left-0 top-full z-50 pt-2">
            <div class="min-w-[180px] rounded-lg border border-border bg-card py-2 shadow-xl">
              {resourceLinks.map((link) => (
                <a href={link.href} aria-current={active(link.href) ? 'page' : undefined} class:list={["block px-4 py-2 text-sm font-medium transition-colors hover:bg-muted hover:text-primary focus-visible:bg-muted focus-visible:text-primary focus-visible:outline-none", active(link.href) ? "bg-muted/50 text-primary" : "text-foreground/80"]}>{link.label}</a>
              ))}
            </div>
          </div>
        </details>

        <a href="/health-check/" class="relative overflow-hidden rounded-full px-3 py-1.5 text-sm font-semibold text-primary shadow-[0_0_20px_rgba(0,173,132,0.3),0_0_40px_rgba(0,173,132,0.1),inset_0_0_20px_rgba(0,173,132,0.05)] transition-shadow hover:shadow-[0_0_25px_rgba(0,173,132,0.45),0_0_45px_rgba(0,173,132,0.15)]" style="background:linear-gradient(135deg,rgba(0,173,132,.15) 0%,rgba(0,173,132,0.05) 100%)">
          <span class="relative z-10">Free Health Check</span>
          <span class="absolute inset-0 rounded-full opacity-50" style="background:linear-gradient(135deg,rgba(0,173,132,.2) 0%,transparent 50%)" aria-hidden="true"></span>
        </a>
      </div>

      <a href="/contact/" class="hidden h-10 items-center justify-center rounded-md bg-[#008466] px-6 text-sm font-medium text-white transition-colors hover:bg-[#007A5E] md:inline-flex">Get Free Consultation</a>

      <button id="mobile-menu-button" class="rounded-md p-2 md:hidden" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle menu">
        <svg id="menu-open-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg id="menu-close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden inert class="border-t border-border bg-background md:hidden">
    <div class="container flex flex-col gap-2 py-4">
      <a href={homeLink.href} class:list={["block py-2 text-base font-medium", active(homeLink.href) ? "text-primary" : "text-foreground/80"]}>{homeLink.label}</a>
      <details class="group py-2" id="mobile-services-menu"><summary class:list={["flex list-none items-center justify-between text-base font-medium [&::-webkit-details-marker]:hidden", servicesActive ? "text-primary" : "text-foreground/80"]}>Services <svg class="h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary><div class="mt-2 ml-4 flex flex-col gap-2 border-l-2 border-border pl-4">{serviceLinks.map((link) => <a href={link.href} class="block py-1.5 text-sm font-medium text-foreground/70">{link.label}</a>)}<a href="/services/" class="block py-1.5 text-sm font-semibold text-primary">View all services →</a></div></details>
      <a href={caseStudiesLink.href} class:list={["block py-2 text-base font-medium", active(caseStudiesLink.href) ? "text-primary" : "text-foreground/80"]}>{caseStudiesLink.label}</a>
      <details class="group py-2" id="mobile-resources-menu">
        <summary class:list={["flex list-none items-center justify-between text-base font-medium [&::-webkit-details-marker]:hidden", resourcesActive ? "text-primary" : "text-foreground/80"]}>
          Resources
          <svg class="h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="mt-2 ml-4 flex flex-col gap-2 border-l-2 border-border pl-4">
          {resourceLinks.map((link) => <a href={link.href} class:list={["block py-1.5 text-sm font-medium", active(link.href) ? "text-primary" : "text-foreground/70"]}>{link.label}</a>)}
        </div>
      </details>
      <a href="/health-check/" class="rounded-lg bg-primary/10 px-4 py-2 text-base font-semibold text-primary shadow-[0_0_15px_rgba(0,173,132,0.2)]">✨ Free Health Check</a>
      <a href="/contact/" class="mt-2 inline-flex h-10 items-center justify-center rounded-md bg-[#008466] px-6 text-sm font-medium text-white hover:bg-[#007A5E]">Get Free Consultation</a>
    </div>
  </div>
</nav>

<script>
  const button = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const openIcon = document.querySelector<HTMLElement>('#menu-open-icon');
  const closeIcon = document.querySelector<HTMLElement>('#menu-close-icon');
  const setMobileIcons = (open: boolean) => {
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  };
  const openMobile = () => {
    if (!button || !menu) return;
    window.clearTimeout(Number(menu.dataset.closeTimer));
    menu.hidden = false; menu.inert = false;
    requestAnimationFrame(() => menu.dataset.open = 'true');
    button.setAttribute('aria-expanded', 'true'); setMobileIcons(true);
  };
  const closeMobile = () => {
    if (!button || !menu) return;
    menu.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((details) => { details.open = false; });
    menu.inert = true; delete menu.dataset.open;
    button.setAttribute('aria-expanded', 'false'); setMobileIcons(false);
    const timer = window.setTimeout(() => { if (button.getAttribute('aria-expanded') === 'false') menu.hidden = true; }, 220);
    menu.dataset.closeTimer = String(timer);
  };
  button?.addEventListener('click', () => button.getAttribute('aria-expanded') === 'true' ? closeMobile() : openMobile());

  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMobile));
  const resources = document.querySelector<HTMLDetailsElement>('#resources-menu');
  const services = document.querySelector<HTMLDetailsElement>('#services-menu');
  const servicesSummary = services?.querySelector('summary');
  const summary = resources?.querySelector('summary');
  const closeDropdown = (dropdown?: HTMLDetailsElement | null) => {
    if (!dropdown) return;
    dropdown.open = false;
    delete dropdown.dataset.hoverOpen;
  };
  const manageDropdown = (menu: HTMLDetailsElement, other?: HTMLDetailsElement | null) => {
    const menuSummary = menu.querySelector('summary');
    if (!menuSummary) return;
    const clearHoverState = () => delete menu.dataset.hoverOpen;
    menu.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'mouse') return;
      if (!menu.open) {
        menu.open = true;
        menu.dataset.hoverOpen = 'true';
      }
      closeDropdown(other);
    });
    menuSummary.addEventListener('click', event => {
      event.preventDefault();
      if (menu.dataset.hoverOpen === 'true') {
        menu.open = true;
        clearHoverState();
      } else {
        menu.open = !menu.open;
      }
      if (menu.open) closeDropdown(other);
    });
    menu.addEventListener('pointerleave', () => {
      if (!menu.contains(document.activeElement)) closeDropdown(menu);
    });
    menu.addEventListener('focusout', event => {
      if (!(event.relatedTarget instanceof Node) || !menu.contains(event.relatedTarget)) closeDropdown(menu);
    });
  };
  if (resources) manageDropdown(resources, services);
  if (services) manageDropdown(services, resources);
  document.addEventListener('click', event => {
    if (!(event.target instanceof Node)) return;
    if (resources && !resources.contains(event.target)) closeDropdown(resources);
    if (services && !services.contains(event.target)) closeDropdown(services);
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    if (resources?.open) { closeDropdown(resources); summary?.focus(); }
    if (services?.open) { closeDropdown(services); servicesSummary?.focus(); }
    if (button?.getAttribute('aria-expanded') === 'true') { closeMobile(); button.focus(); }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', closeMobile);
</script>
