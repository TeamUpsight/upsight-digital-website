<section class="service-panel" data-event-inspector data-testid="event-journey-inspector">
  <div class="flex flex-col justify-between gap-4 md:flex-row"><div><p class="service-kicker">EVENT JOURNEY INSPECTOR</p><h2 class="service-heading mt-3">See what a usable event carries</h2></div><p class="max-w-md text-sm text-muted-foreground">Illustrative event example. The exact fields are defined around your journeys, systems, and reporting needs.</p></div>
  <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Choose an example event"><button class="service-toggle" data-event="view_item" role="tab" aria-selected="false">Product View</button><button class="service-toggle" data-event="add_to_cart" role="tab" aria-selected="false">Add to Cart</button><button class="service-toggle" data-event="lead" role="tab" aria-selected="false">Lead Submitted</button><button class="service-toggle is-active" data-event="purchase" role="tab" aria-selected="true">Purchase</button></div>
  <div class="journey-flow mt-7" role="tabpanel" tabindex="0"><div><small>USER ACTION</small><strong data-action>Checkout completed</strong></div><span aria-hidden="true">↓</span><div><small>DATA LAYER</small><code data-layer>event: purchase<br />transaction_id: 102847<br />value: 249.00<br />currency: AED</code></div><span aria-hidden="true">↓</span><div><small>GOOGLE TAG MANAGER</small><strong data-gtm>Trigger: purchase<br />Tags: GA4 Event, Google Ads</strong></div><span aria-hidden="true">↓</span><div><small>GA4</small><strong data-ga4>Event: purchase<br />Parameters: transaction_id, value, currency, items</strong></div><span aria-hidden="true">↓</span><div><small>REPORTING</small><strong data-reporting>Revenue · Transactions · Products</strong></div></div>
  <details class="mt-6 rounded-xl border border-border bg-background/60 p-4"><summary class="cursor-pointer font-semibold">Inspect event payload</summary><div class="event-payload mt-4"><p class="service-kicker">EVENT PAYLOAD</p><pre><code data-payload></code></pre></div></details>
  <div class="mt-6 rounded-xl border border-border bg-background/60 p-4"><div class="flex flex-wrap items-center justify-between gap-3"><div><p class="font-semibold">QA check: purchase journey</p><p class="text-sm text-muted-foreground">Product → Cart → Checkout → Purchase</p></div><button class="service-toggle" data-broken aria-pressed="false">Show broken example</button></div><pre class="mt-4 font-mono text-sm" data-qa>event name  purchase ✓
transaction_id  #102847 ✓
value  249.00 ✓
items  3 products ✓
duplicate check  passed ✓</pre></div>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-event-inspector]');
  if (root) {
    const item = { item_id:'SKU-1001', item_name:'Performance Hoodie', item_brand:'Example Brand', item_category:'Apparel', item_variant:'Black / M', price:149, quantity:1 };
    const events = {
      view_item: { action:'Product viewed', layer:'event: view_item\nvalue: 149.00\ncurrency: AED\nitems: [...]', gtm:'Trigger: view_item\nTags: GA4 Event', ga4:'Event: view_item\nParameters: value, currency, items', reporting:'Product performance · Views', payload:{ event:'view_item', ecommerce:{ currency:'AED', value:149, items:[item] } } },
      add_to_cart: { action:'Add to cart clicked', layer:'event: add_to_cart\nvalue: 149.00\ncurrency: AED\nitems: [...]', gtm:'Trigger: add_to_cart\nTags: GA4 Event', ga4:'Event: add_to_cart\nParameters: value, currency, items', reporting:'Cart activity · Products', payload:{ event:'add_to_cart', ecommerce:{ currency:'AED', value:149, items:[item] } } },
      lead: { action:'Lead form submitted', layer:'event: generate_lead\nform_id: contact\nlead_type: consultation', gtm:'Trigger: generate_lead\nTags: GA4 Event, Google Ads', ga4:'Event: generate_lead\nParameters: form_id, lead_type, page_location', reporting:'Leads · Form performance', payload:{ event:'generate_lead', form_id:'contact', lead_type:'consultation', page_location:'https://example.com/contact/' } },
      purchase: { action:'Checkout completed', layer:'event: purchase\ntransaction_id: 102847\nvalue: 249.00\ncurrency: AED', gtm:'Trigger: purchase\nTags: GA4 Event, Google Ads', ga4:'Event: purchase\nParameters: transaction_id, value, currency, items', reporting:'Revenue · Transactions · Products', payload:{ event:'purchase', ecommerce:{ transaction_id:'102847', value:249, tax:11.86, shipping:15, currency:'AED', coupon:'', items:[item,{ item_id:'SKU-2048', item_name:'Analytics Cap', item_brand:'Example Brand', item_category:'Accessories', item_variant:'Black', price:100, quantity:1 }] } } },
    };
    let current: keyof typeof events = 'purchase', broken = false;
    const render = () => {
      const data = events[current];
      (['action','layer','gtm','ga4','reporting'] as const).forEach(key => root.querySelector(`[data-${key}]`)!.textContent = data[key]);
      root.querySelector('[data-payload]')!.textContent = JSON.stringify(data.payload, null, 2);
      root.querySelectorAll<HTMLButtonElement>('[data-event]').forEach(button => { const active = button.dataset.event === current; button.classList.toggle('is-active', active); button.setAttribute('aria-selected', String(active)); });
      root.querySelector('[data-qa]')!.textContent = broken ? 'event name  purchase ✓\ntransaction_id  missing ✕\nvalue  "249 AED" ✕\nitems  empty ✕' : 'event name  purchase ✓\ntransaction_id  #102847 ✓\nvalue  249.00 ✓\nitems  3 products ✓\nduplicate check  passed ✓';
    };
    render();
    root.addEventListener('click', event => { const eventButton = (event.target as Element).closest<HTMLButtonElement>('[data-event]'); const brokenButton = (event.target as Element).closest<HTMLButtonElement>('[data-broken]'); if (eventButton) { current = eventButton.dataset.event as keyof typeof events; render(); } if (brokenButton) { broken = !broken; brokenButton.setAttribute('aria-pressed', String(broken)); brokenButton.textContent = broken ? 'Show valid example' : 'Show broken example'; render(); } });
  }
</script>
