<section class="service-panel" data-event-inspector data-testid="event-journey-inspector"><div class="flex flex-col justify-between gap-4 md:flex-row"><div><p class="service-kicker">EVENT JOURNEY INSPECTOR</p><h2 class="service-heading mt-3">See what a usable event carries</h2></div><p class="max-w-md text-sm text-muted-foreground">Illustrative event example. The exact fields are defined around your journeys, systems, and reporting needs.</p></div><div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Choose an example event"><button class="service-toggle" data-event="view_item" role="tab" aria-selected="false">Product View</button><button class="service-toggle" data-event="add_to_cart" role="tab" aria-selected="false">Add to Cart</button><button class="service-toggle" data-event="lead" role="tab" aria-selected="false">Lead Submitted</button><button class="service-toggle is-active" data-event="purchase" role="tab" aria-selected="true">Purchase</button></div><div class="journey-flow mt-7" role="tabpanel" tabindex="0"><div><small>USER ACTION</small><strong data-action>Checkout completed</strong></div><span aria-hidden="true">↓</span><div><small>DATA LAYER</small><code data-layer>event: purchase<br />transaction_id: 102847<br />value: 249.00<br />currency: AED</code></div><span aria-hidden="true">↓</span><div><small>GOOGLE TAG MANAGER</small><strong data-gtm>Trigger: purchase<br />Tags: GA4 Event, Google Ads</strong></div><span aria-hidden="true">↓</span><div><small>GA4</small><strong data-ga4>Event: purchase<br />Parameters: transaction_id, value, currency, items</strong></div><span aria-hidden="true">↓</span><div><small>REPORTING</small><strong data-reporting>Revenue · Transactions · Products</strong></div></div><details class="mt-6 rounded-xl border border-border bg-background/60 p-4"><summary class="cursor-pointer font-semibold">Inspect event parameters</summary><div class="mt-4 grid gap-2 font-mono text-sm text-muted-foreground" data-parameters>transaction_id<br />value<br />currency<br />tax<br />shipping<br />coupon<br />items[]</div></details><div class="mt-6 rounded-xl border border-border bg-background/60 p-4"><div class="flex flex-wrap items-center justify-between gap-3"><div><p class="font-semibold">QA check: purchase journey</p><p class="text-sm text-muted-foreground">Product → Cart → Checkout → Purchase</p></div><button class="service-toggle" data-broken aria-pressed="false">Show broken example</button></div><div class="mt-4 grid gap-2 font-mono text-sm" data-qa><span>event name <b>purchase ✓</b></span><span>transaction_id <b>#102847 ✓</b></span><span>value <b>249.00 ✓</b></span><span>items <b>3 products ✓</b></span><span>duplicate check <b>passed ✓</b></span></div></div></section>
<script>
  const root = document.querySelector<HTMLElement>('[data-event-inspector]');
  if (root) { const events = { purchase:['Checkout completed','event: purchase\ntransaction_id: 102847\nvalue: 249.00\ncurrency: AED','Trigger: purchase\nTags: GA4 Event, Google Ads','Event: purchase\nParameters: transaction_id, value, currency, items','Revenue · Transactions · Products','transaction_id\nvalue\ncurrency\ntax\nshipping\ncoupon\nitems[]'], view_item:['Product viewed','event: view_item\nvalue: 249.00\ncurrency: AED\nitems: [...]','Trigger: view_item\nTags: GA4 Event','Event: view_item\nParameters: value, currency, items','Product performance · Views','currency\nvalue\nitems[]'], add_to_cart:['Add to cart clicked','event: add_to_cart\nvalue: 249.00\ncurrency: AED\nitems: [...]','Trigger: add_to_cart\nTags: GA4 Event','Event: add_to_cart\nParameters: value, currency, items','Cart activity · Products','currency\nvalue\nitems[]'], lead:['Lead form submitted','event: generate_lead\nform_id: contact\nlead_type: consultation','Trigger: generate_lead\nTags: GA4 Event, Google Ads','Event: generate_lead\nParameters: form_id, lead_type, page_location','Leads · Form performance','form_id\nlead_type\npage_location'] }; let current: keyof typeof events = 'purchase', broken = false; const render = () => { const data = events[current]; (['action','layer','gtm','ga4','reporting','parameters'] as const).forEach((key, index) => root.querySelector(`[data-${key}]`)!.textContent = data[index]); root.querySelectorAll<HTMLButtonElement>('[data-event]').forEach(button => { const active = button.dataset.event === current; button.classList.toggle('is-active', active); button.setAttribute('aria-selected', String(active)); }); root.querySelector('[data-qa]')!.innerHTML = broken ? '<span>event name <b>purchase ✓</b></span><span>transaction_id <b class="text-destructive">missing ✕</b></span><span>value <b class="text-destructive">"249 AED" ✕</b></span><span>items <b class="text-destructive">empty ✕</b></span>' : '<span>event name <b>purchase ✓</b></span><span>transaction_id <b>#102847 ✓</b></span><span>value <b>249.00 ✓</b></span><span>items <b>3 products ✓</b></span><span>duplicate check <b>passed ✓</b></span>'; }; root.addEventListener('click', event => { const eventButton = (event.target as Element).closest<HTMLButtonElement>('[data-event]'); const brokenButton = (event.target as Element).closest<HTMLButtonElement>('[data-broken]'); if (eventButton) { current = eventButton.dataset.event as keyof typeof events; render(); } if (brokenButton) { broken = !broken; brokenButton.setAttribute('aria-pressed', String(broken)); brokenButton.textContent = broken ? 'Show valid example' : 'Show broken example'; render(); } }); }
</script>
