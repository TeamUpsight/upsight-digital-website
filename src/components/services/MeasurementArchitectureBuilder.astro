---
const scenarios=['Ecommerce','Lead Generation','Mobile App'];
---
<section id="architecture-builder" class="rounded-2xl border border-border bg-card p-5 md:p-8" aria-labelledby="architecture-builder-title"><p class="service-kicker">ARCHITECTURE EXPLORER</p><h2 id="architecture-builder-title" class="service-heading mt-2">Choose a measurement scenario</h2><div class="mt-5 flex flex-wrap gap-2">{scenarios.map((x,i)=><button type="button" data-scenario={x} aria-pressed={i===0?'true':'false'} class="rounded-full border px-4 py-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">{x}</button>)}</div>
<div class="mt-6 grid gap-6 lg:grid-cols-[1.4fr_.8fr]"><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Illustrative system flow">{['Sources','Collection','Processing','Destinations'].map((stage,i)=><article class="rounded-xl border bg-background p-4"><p class="service-kicker">0{i+1} · {stage.toUpperCase()}</p><button type="button" data-node={stage} class="mt-3 text-left font-semibold underline decoration-dotted underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">{i===0?'Website · Orders · CRM':i===1?'dataLayer · SDK · API':i===2?'sGTM · Identity · Warehouse':'Analytics · Ads · BI'}</button><p class="mt-2 text-sm text-muted-foreground" data-stage={stage}>Select for connection details</p>{i<3&&<p aria-hidden="true" class="mt-3 text-primary">↓ next stage</p>}</article>)}</div><aside class="rounded-xl bg-muted/40 p-5" aria-live="polite"><p class="service-kicker">NODE INSPECTOR</p><h3 id="node-name" class="mt-2 text-xl font-semibold">Sources</h3><dl class="mt-4 space-y-3 text-sm"><div><dt class="font-semibold">Role</dt><dd id="node-role" class="text-muted-foreground">Business and operational systems originate the measured activity.</dd></div><div><dt class="font-semibold">Input / output</dt><dd id="node-io" class="text-muted-foreground">Receives user and transaction activity; provides timestamped source events.</dd></div><div><dt class="font-semibold">Identifiers</dt><dd id="node-ids" class="text-muted-foreground">Order, lead, account or app-instance identifiers as appropriate.</dd></div><div><dt class="font-semibold">Owner and validation</dt><dd id="node-owner" class="text-muted-foreground">Client product, marketing or development owner; reconcile samples to source records.</dd></div></dl></aside></div>
<p class="mt-5 text-sm text-muted-foreground">Illustrative patterns only. Actual architecture, identifiers, consent behavior and destination support depend on the organization's systems and requirements.</p></section>
<script>
  const architectures: Record<string,string[]>={Ecommerce:['Website · Backend orders · CRM','dataLayer / GTM · order API','Server-side GTM · optional warehouse','GA4 · Google Ads · Meta · reporting'], 'Lead Generation':['Website · Forms · Calls · CRM','GTM · call integration · form API','Identity / attribution · server routing','GA4 · ad platforms · CRM reports · dashboards'], 'Mobile App':['App · Backend · Subscription system','Product SDK · MMP SDK · backend API','Identity and event architecture','Product analytics · MMP · partners · BI']};
  const nodeInfo: Record<string,[string,string,string,string]>={Sources:['Business and operational systems originate measured activity.','User and transaction activity becomes source events.','Order, lead, account or app-instance identifiers as appropriate.','Client product, marketing or development owner; reconcile samples to source records.'],Collection:['Collection maps source actions into governed events.','Receives source actions; emits validated event payloads.','Event IDs, session or device IDs, approved campaign IDs.','Client development with analytics specification; inspect payloads in test environments.'],Processing:['Processing applies agreed routing and transformations.','Receives source events; outputs consent-aware normalized events.','Event ID, transaction ID and consent state where required.','Analytics/backend owners; compare transformed payloads and routing rules.'],Destinations:['Destinations serve analytics, advertising or reporting needs.','Receives mapped events; returns reports or partner postbacks where configured.','Destination-specific event and deduplication identifiers.','Platform owners; reconcile source totals, delivery diagnostics and reporting.']};
  document.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach(item=>{const active=item===button;item.setAttribute('aria-pressed',String(active));item.classList.toggle('bg-primary/10',active);item.classList.toggle('border-primary',active)});const values=architectures[button.dataset.scenario||'Ecommerce'];document.querySelectorAll<HTMLElement>('[data-stage]').forEach((el,index)=>{el.textContent=values[index]})}));
  document.querySelectorAll<HTMLButtonElement>('[data-node]').forEach(button=>button.addEventListener('click',()=>{const name=button.dataset.node||'Sources';const info=nodeInfo[name];document.querySelector('#node-name')!.textContent=name;['#node-role','#node-io','#node-ids','#node-owner'].forEach((selector,index)=>{document.querySelector(selector)!.textContent=info[index]})}));
</script>
