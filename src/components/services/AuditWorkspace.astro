---
const findings = [
  { id:'purchase', area:'GA4 Purchase', finding:'Purchase fires again when the confirmation page is reloaded', severity:'Critical', owner:'Development', evidence:'Two purchase events were observed using the same order during a page refresh test.', impact:'Duplicate purchase events can inflate transaction and revenue reporting.', fix:'Introduce transaction-level duplicate protection and validate refresh/retry behavior.' },
  { id:'transaction', area:'Ecommerce', finding:'transaction_id is missing on selected purchase events', severity:'High', owner:'Development', evidence:'The illustrative payload contains a purchase event without a stable transaction identifier.', impact:'Destinations cannot reliably identify a purchase or prevent duplicates.', fix:'Expose the order identifier in the data layer and validate it through each destination.' },
  { id:'consent', area:'Consent', finding:'Marketing tag initializes before the example consent update', severity:'High', owner:'Analytics', evidence:'The example tag sequence shows an advertising tag before the configured consent update.', impact:'Teams need a clear technical view of which tags may run for each consent state.', fix:'Review CMP timing, GTM consent checks, and the agreed consent-state routing.' },
  { id:'capi', area:'Meta CAPI', finding:'Browser and server purchase events use inconsistent event IDs', severity:'High', owner:'Analytics', evidence:'Browser and server event examples use different identifiers for the same purchase.', impact:'Destinations may not deduplicate equivalent browser and server events as intended.', fix:'Define an event_id strategy shared by browser and server delivery.' },
  { id:'legacy', area:'GTM', finding:'Legacy tags remain active with unclear ownership', severity:'Medium', owner:'Marketing', evidence:'Container inventory includes tags without a documented owner or current destination.', impact:'Unowned tags make changes, privacy review, and debugging harder.', fix:'Assign ownership, document purpose, and remove or govern obsolete tags.' },
  { id:'parameters', area:'GA4', finding:'Recommended ecommerce parameters are incomplete', severity:'Medium', owner:'Development', evidence:'The example ecommerce event omits selected item-level fields.', impact:'Incomplete parameters can reduce the usefulness of product and revenue reporting.', fix:'Agree the required item and event fields, then update the data-layer specification.' },
];
---
<section class="service-panel" data-audit-workspace data-testid="audit-workspace"><div class="flex flex-col justify-between gap-4 md:flex-row"><div><p class="service-kicker">EXAMPLE AUDIT WORKSPACE</p><h2 class="service-heading mt-3">Evidence first. Remediation second.</h2></div><div class="font-mono text-xs leading-6 text-muted-foreground">AUDIT: Ecommerce Measurement<br />ENVIRONMENT: Production<br />STATUS: {findings.length} findings</div></div><p class="mt-4 text-sm text-muted-foreground">Example audit interface using illustrative findings.</p><div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Filter audit findings"><button class="service-toggle is-active" data-filter="All" aria-pressed="true" aria-label="Show all findings">All</button>{['Critical','High','Medium'].map(filter => <button class="service-toggle" data-filter={filter} aria-pressed="false" aria-label={`Filter severity: ${filter}`}>{filter}</button>)}</div><div class="audit-list mt-6">{findings.map((item, index) => <article class="audit-item" data-severity={item.severity}><button class="audit-row" data-finding={item.id} aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`${item.id}-detail`}><span><small>{item.area}</small><strong>{item.finding}</strong></span><span class="hidden text-sm text-muted-foreground md:block">{item.owner}</span><span class="audit-severity" data-severity={item.severity}>{item.severity}</span></button><div id={`${item.id}-detail`} class="audit-detail" hidden={index !== 0}><div><small>Evidence</small><p>{item.evidence}</p></div><div><small>Why it matters</small><p>{item.impact}</p></div><div><small>Recommended fix</small><p>{item.fix}</p></div><div><small>Suggested owner</small><p>{item.owner}</p></div></div></article>)}</div></section>
<script>
  const workspace = document.querySelector<HTMLElement>('[data-audit-workspace]');
  if (workspace) workspace.addEventListener('click', event => {
    const filter = (event.target as Element).closest<HTMLButtonElement>('[data-filter]');
    if (filter) { const value = filter.dataset.filter!; workspace.querySelectorAll<HTMLElement>('[data-severity]').forEach(item => item.closest('.audit-item')?.toggleAttribute('hidden', value !== 'All' && item.dataset.severity !== value)); workspace.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => { const active = button === filter; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); }); return; }
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-finding]'); if (!button) return; const detail = document.getElementById(`${button.dataset.finding}-detail`)!; const expanded = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!expanded)); detail.hidden = expanded;
  });
</script>
