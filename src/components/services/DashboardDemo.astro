<section class="dashboard-demo" data-dashboard-demo data-testid="dashboard-demo" aria-label="Interactive dashboard demo using illustrative data">
  <div class="dashboard-top"><div><p class="service-kicker">INTERACTIVE DEMO USING ILLUSTRATIVE DATA</p><h2 class="service-heading mt-3">A reporting workspace, not a collection of charts</h2></div><div class="dashboard-filters"><label>Period <select data-filter="period"><option value="7">Last 7 Days</option><option value="30" selected>Last 30 Days</option><option value="90">Quarter</option></select></label><label>Market <select data-filter="market"><option>All Markets</option><option>UAE</option><option>UK</option><option>US</option></select></label><label>Channel <select data-filter="channel"><option>All Channels</option><option>Google Ads</option><option>Meta</option><option>Organic</option></select></label></div></div>
  <div class="dashboard-kpis mt-5"><article><span>Revenue</span><strong data-kpi="revenue">AED 184,240</strong><small>Illustrative data</small></article><article><span>Orders</span><strong data-kpi="orders">612</strong><small>Illustrative data</small></article><article><span>Conversion Rate</span><strong data-kpi="conversion">2.8%</strong><small>Illustrative data</small></article><article><span>Media Spend</span><strong data-kpi="spend">AED 54,600</strong><small>Illustrative data</small></article><article><span>CPA</span><strong data-kpi="cpa">AED 89.22</strong><small>Illustrative data</small></article><article><span>ROAS</span><strong data-kpi="roas">3.37x</strong><small>Illustrative data</small></article></div>
  <div class="dashboard-grid mt-5"><article class="dashboard-chart"><div class="flex items-center justify-between"><h3>Revenue trend</h3><span class="font-mono text-xs text-primary" data-chart-label>Last 30 days</span></div><svg viewBox="0 0 420 150" role="img" aria-label="Illustrative revenue trend chart" class="mt-4 h-40 w-full"><path d="M8 125H412M8 85H412M8 45H412" class="dashboard-gridline"/><polyline data-trend fill="none" stroke="#25c99e" stroke-width="4" points="8,117 74,104 140,112 205,70 270,86 336,38 412,54"/><circle data-last-point cx="412" cy="54" r="5" fill="#25c99e"/></svg></article><article class="dashboard-chart"><h3>Conversion funnel</h3><ol class="dashboard-funnel mt-4"><li><span>Sessions</span><b data-funnel="sessions">21,860</b></li><li><span>Product Views</span><b data-funnel="views">8,940</b></li><li><span>Add to Cart</span><b data-funnel="cart">1,990</b></li><li><span>Checkout</span><b data-funnel="checkout">920</b></li><li><span>Orders</span><b data-funnel="orders">612</b></li></ol></article><article class="dashboard-chart dashboard-table-wrap"><h3>Channel performance</h3><table class="mt-4 w-full text-left text-sm"><thead><tr><th scope="col">Channel</th><th scope="col">Spend</th><th scope="col">Revenue</th><th scope="col">Orders</th><th scope="col">ROAS</th></tr></thead><tbody data-dashboard-table><tr><th scope="row">Google Ads</th><td>AED 28,400</td><td>AED 86,400</td><td>251</td><td>3.04x</td></tr><tr><th scope="row">Meta</th><td>AED 26,200</td><td>AED 54,640</td><td>165</td><td>2.09x</td></tr><tr><th scope="row">Organic</th><td>—</td><td>AED 43,200</td><td>196</td><td>—</td></tr></tbody></table></article></div>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-dashboard-demo]');
  if (root) {
    const selects = [...root.querySelectorAll<HTMLSelectElement>('[data-filter]')];
    const format = (number:number) => new Intl.NumberFormat('en-US').format(Math.round(number));
    const render = () => { const period=Number(selects.find(x=>x.dataset.filter==='period')!.value); const market=selects.find(x=>x.dataset.filter==='market')!.value; const channel=selects.find(x=>x.dataset.filter==='channel')!.value; const factor=(period===7?.29:period===90?2.85:1)*(market==='All Markets'?1:market==='UAE'?.46:market==='UK'?.31:.23)*(channel==='All Channels'?1:channel==='Google Ads'?.47:channel==='Meta'?.3:.23); const revenue=184240*factor, orders=612*factor, spend=54600*factor*(channel==='Organic'?0:.98); const values={revenue:`AED ${format(revenue)}`,orders:format(orders),conversion:`${(2.8*(market==='US'?.92:1)).toFixed(1)}%`,spend:channel==='Organic'?'—':`AED ${format(spend)}`,cpa:channel==='Organic'?'—':`AED ${(spend/Math.max(orders,1)).toFixed(2)}`,roas:channel==='Organic'?'—':`${(revenue/Math.max(spend,1)).toFixed(2)}x`}; Object.entries(values).forEach(([key,value])=>root.querySelector(`[data-kpi="${key}"]`)!.textContent=value); root.querySelector('[data-chart-label]')!.textContent=`${period === 90 ? 'Quarter' : `Last ${period} days`} · ${market} · ${channel}`; const curve=period===7?'8,110 74,88 140,98 205,62 270,78 336,41 412,52':period===90?'8,122 74,93 140,106 205,57 270,73 336,30 412,45':'8,117 74,104 140,112 205,70 270,86 336,38 412,54'; root.querySelector('[data-trend]')!.setAttribute('points',curve); const counts={sessions:21860*factor,views:8940*factor,cart:1990*factor,checkout:920*factor,orders}; Object.entries(counts).forEach(([key,value])=>root.querySelector(`[data-funnel="${key}"]`)!.textContent=format(value)); const channels=channel==='All Channels'?['Google Ads','Meta','Organic']:[channel]; root.querySelector('[data-dashboard-table]')!.innerHTML=channels.map((name,index)=>{const share=channels.length===1?1:[.47,.3,.23][index];const localRevenue=revenue*share;const localSpend=name==='Organic'?0:spend*share;return `<tr><th scope="row">${name}</th><td>${localSpend?`AED ${format(localSpend)}`:'—'}</td><td>AED ${format(localRevenue)}</td><td>${format(orders*share)}</td><td>${localSpend?(localRevenue/localSpend).toFixed(2)+'x':'—'}</td></tr>`}).join(''); };
    selects.forEach(select=>select.addEventListener('change',render)); render();
  }
</script>
