---
import { buttonClasses } from '../../lib/button-styles';
interface Props { title: string; detail: string; primaryLabel: string; primaryHref?: string; secondaryLabel?: string; secondaryHref?: string; }
const { title, detail, primaryLabel, primaryHref = '/contact/', secondaryLabel, secondaryHref = '/health-check/' } = Astro.props;
---
<section class="service-cta"><div class="container"><div class="rounded-2xl border border-primary/35 bg-card/75 px-6 py-10 text-center md:px-12"><p class="service-kicker">NEXT STEP</p><h2 class="service-heading mt-4">{title}</h2><p class="mx-auto mt-4 max-w-2xl text-muted-foreground">{detail}</p><div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row"><a class={buttonClasses({ size: 'lg', className: 'h-12 px-8 text-base' })} href={primaryHref}>{primaryLabel}</a>{secondaryLabel && <a class={buttonClasses({ variant: 'outline', size: 'lg', className: 'h-12 px-8 text-base' })} href={secondaryHref}>{secondaryLabel}</a>}</div></div></div></section>
