<section class="service-panel consent-simulator" data-consent-simulator data-testid="consent-routing-simulator">
  <div class="flex flex-col justify-between gap-4 md:flex-row"><div><p class="service-kicker">CONSENT ROUTING SIMULATOR</p><h2 class="service-heading mt-3">See how a choice reaches the measurement system</h2></div><p class="max-w-md text-sm leading-6 text-muted-foreground">Illustrative simplified policy. Actual routing depends on CMP configuration, Consent Mode, tag settings, platform requirements, and approved privacy/legal rules.</p></div>
  <div class="mt-6 flex flex-wrap gap-2" aria-label="Choose illustrative consent state"><button class="service-toggle" data-consent="all" aria-pressed="false">Accept All</button><button class="service-toggle is-active" data-consent="analytics" aria-pressed="true">Analytics Only</button><button class="service-toggle" data-consent="reject" aria-pressed="false">Reject Non-Essential</button></div>
  <div class="consent-grid mt-6"><article><p class="service-kicker">CONSENT SIGNALS</p><dl class="mt-4 space-y-3" data-consent-signals><div><dt>analytics_storage</dt><dd class="consent-granted">granted</dd></div><div><dt>ad_storage</dt><dd class="consent-denied">denied</dd></div><div><dt>ad_user_data</dt><dd class="consent-denied">denied</dd></div><div><dt>ad_personalization</dt><dd class="consent-denied">denied</dd></div></dl></article><article><p class="service-kicker">TAG ROUTING</p><dl class="mt-4 space-y-3" data-tag-routing><div><dt>GA4</dt><dd class="consent-granted">Full measurement</dd></div><div><dt>Google Ads</dt><dd class="consent-restricted">Consent-restricted behaviour</dd></div><div><dt>Meta Pixel</dt><dd class="consent-denied">Blocked by configured consent rule</dd></div><div><dt>TikTok</dt><dd class="consent-denied">Blocked by configured consent rule</dd></div></dl></article></div>
  <p class="mt-5 rounded-xl border border-border bg-background/50 p-4 text-sm text-muted-foreground">Google Consent Mode can be implemented in Basic or Advanced mode. The appropriate approach must be agreed with the client’s privacy/legal stakeholders; this demo does not determine legal appropriateness.</p>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-consent-simulator]');
  if (root) {
    const data: Record<string,{signals:string[],routing:string[]}> = { all:{signals:['granted','granted','granted','granted'],routing:['Full measurement','Full measurement','Allowed by configured consent rule','Allowed by configured consent rule']}, analytics:{signals:['granted','denied','denied','denied'],routing:['Full measurement','Consent-restricted behaviour','Blocked by configured consent rule','Blocked by configured consent rule']}, reject:{signals:['denied','denied','denied','denied'],routing:['Consent-restricted behaviour','Consent-restricted behaviour','Blocked by configured consent rule','Blocked by configured consent rule']} }; let selected='analytics';
    const stateClass=(value:string)=>value==='granted'||value==='Full measurement'||value.startsWith('Allowed')?'consent-granted':value.startsWith('Consent')?'consent-restricted':'consent-denied';
    const render=()=>{const state=data[selected];root.querySelectorAll('[data-consent-signals] dd').forEach((el,index)=>{el.textContent=state.signals[index];el.className=stateClass(state.signals[index]);});root.querySelectorAll('[data-tag-routing] dd').forEach((el,index)=>{el.textContent=state.routing[index];el.className=stateClass(state.routing[index]);});root.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach(button=>{const active=button.dataset.consent===selected;button.classList.toggle('is-active',active);button.setAttribute('aria-pressed',String(active));});};root.addEventListener('click',event=>{const button=(event.target as Element).closest<HTMLButtonElement>('[data-consent]');if(button){selected=button.dataset.consent!;render();}});render();
  }
</script>
