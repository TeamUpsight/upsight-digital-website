<section class="service-panel consent-simulator" data-consent-simulator data-testid="consent-routing-simulator" aria-labelledby="consent-simulator-title">
  <div class="flex flex-col justify-between gap-4 md:flex-row"><div><p class="service-kicker">CONSENT ROUTING SIMULATOR</p><h3 id="consent-simulator-title" class="service-heading mt-3">Explore an illustrative consent state</h3></div><p class="max-w-md text-sm leading-6 text-muted-foreground">Actual routing depends on the CMP, consent model, tag settings, platform requirements and approved privacy rules. This is a technical example, not a legal decision.</p></div>
  <div class="mt-6"><p class="service-kicker mb-3">VISITOR CHOICE</p><div class="flex flex-wrap gap-2" role="group" aria-label="Choose illustrative consent state"><button type="button" class="service-toggle" data-consent="all" aria-pressed="false">Accept All</button><button type="button" class="service-toggle is-active" data-consent="analytics" aria-pressed="true">Analytics Only</button><button type="button" class="service-toggle" data-consent="reject" aria-pressed="false">Reject Non-Essential</button></div></div>
  <div class="mt-6 rounded-xl border border-border bg-background/40 p-4"><div class="flex flex-wrap items-center justify-between gap-3"><div><p class="service-kicker">US OPT-OUT EXAMPLE</p><p class="mt-2 text-sm text-muted-foreground">GPC signal</p></div><button type="button" class="service-toggle" data-gpc aria-pressed="false">Not detected</button></div><p class="mt-3 text-xs leading-5 text-muted-foreground">When detected in this example, the applicable marketing / sale-sharing route is restricted. GPC does not automatically block all analytics. Exact effects depend on applicable laws, business practices, approved privacy rules and destination configuration.</p></div>
  <div class="consent-grid mt-6"><article><p class="service-kicker">GOOGLE CONSENT SIGNALS</p><dl class="mt-4 space-y-3" data-consent-signals><div><dt>analytics_storage</dt><dd class="consent-granted">granted</dd></div><div><dt>ad_storage</dt><dd class="consent-denied">denied</dd></div><div><dt>ad_user_data</dt><dd class="consent-denied">denied</dd></div><div><dt>ad_personalization</dt><dd class="consent-denied">denied</dd></div></dl></article><article><p class="service-kicker">ILLUSTRATIVE TECHNICAL ROUTING</p><dl class="mt-4 space-y-3" data-tag-routing><div><dt>GA4</dt><dd class="consent-restricted">Consent-restricted behaviour</dd></div><div><dt>Google Ads</dt><dd class="consent-restricted">Consent-restricted behaviour</dd></div><div><dt>Meta Pixel</dt><dd class="consent-denied">Blocked by configured marketing rule</dd></div><div><dt>TikTok</dt><dd class="consent-denied">Blocked by configured marketing rule</dd></div><div><dt>Marketing / sale-sharing route</dt><dd class="consent-restricted" data-gpc-route>Available under choice rules</dd></div></dl></article></div>
  <p class="mt-5 rounded-xl border border-border bg-background/50 p-4 text-sm text-muted-foreground">Basic Consent Mode blocks Google tags requiring consent until consent is granted. Advanced Consent Mode can load supported tags with default states and send limited/cookieless measurement when certain storage is denied. The appropriate model must be defined by your organisation’s privacy/legal stakeholders.</p>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-consent-simulator]');
  if (root) {
    const data: Record<string,{signals:string[],routing:string[]}> = {
      all:{signals:['granted','granted','granted','granted'],routing:['Full measurement','Full measurement','Allowed by configured consent rule','Allowed by configured consent rule']},
      analytics:{signals:['granted','denied','denied','denied'],routing:['Consent-restricted behaviour','Consent-restricted behaviour','Blocked by configured marketing rule','Blocked by configured marketing rule']},
      reject:{signals:['denied','denied','denied','denied'],routing:['Consent-restricted behaviour','Consent-restricted behaviour','Blocked by configured marketing rule','Blocked by configured marketing rule']}
    };
    let selected='analytics';
    let gpcDetected=false;
    const stateClass=(value:string)=>value==='granted'||value==='Full measurement'||value.startsWith('Allowed')||value==='Available under choice rules'?'consent-granted':value.startsWith('Consent')||value==='Restricted by detected GPC signal'?'consent-restricted':'consent-denied';
    const render=()=>{
      const state=data[selected];
      root.querySelectorAll('[data-consent-signals] dd').forEach((el,index)=>{el.textContent=state.signals[index];el.className=stateClass(state.signals[index]);});
      root.querySelectorAll('[data-tag-routing] dd:not([data-gpc-route])').forEach((el,index)=>{el.textContent=state.routing[index];el.className=stateClass(state.routing[index]);});
      const gpcRoute=root.querySelector<HTMLElement>('[data-gpc-route]');
      if(gpcRoute){const value=gpcDetected?'Restricted by detected GPC signal':'Available under choice rules';gpcRoute.textContent=value;gpcRoute.className=stateClass(value);}
      root.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach(button=>{const active=button.dataset.consent===selected;button.classList.toggle('is-active',active);button.setAttribute('aria-pressed',String(active));});
      const gpcButton=root.querySelector<HTMLButtonElement>('[data-gpc]');
      if(gpcButton){gpcButton.setAttribute('aria-pressed',String(gpcDetected));gpcButton.textContent=gpcDetected?'Detected':'Not detected';gpcButton.classList.toggle('is-active',gpcDetected);}
    };
    root.addEventListener('click',event=>{const target=event.target as Element;const button=target.closest<HTMLButtonElement>('[data-consent]');if(button){selected=button.dataset.consent!;render();return;}if(target.closest('[data-gpc]')){gpcDetected=!gpcDetected;render();}});
    render();
  }
</script>
<style>
  @media (max-width: 767px) {
    .consent-grid dl div { align-items: flex-start; flex-direction: column; }
    .consent-grid dd { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
  }
</style>
