<section class="service-panel ecommerce-journey" data-ecommerce-journey data-testid="ecommerce-journey">
  <div class="flex flex-col justify-between gap-4 md:flex-row"><div><p class="service-kicker">ECOMMERCE JOURNEY</p><h2 class="service-heading mt-3">Measurement events along the purchase path</h2></div><p class="max-w-md text-sm leading-6 text-muted-foreground">These are recommended measurement events, not a claim that every store has the same visible checkout steps.</p></div>
  <div class="commerce-steps mt-6" role="tablist" aria-label="Choose a commerce event"><button class="service-toggle" data-commerce-event="view_item" role="tab" aria-selected="false">VIEW PRODUCT<small>view_item</small></button><button class="service-toggle" data-commerce-event="add_to_cart" role="tab" aria-selected="false">ADD TO CART<small>add_to_cart</small></button><button class="service-toggle" data-commerce-event="begin_checkout" role="tab" aria-selected="false">CHECKOUT<small>begin_checkout</small></button><button class="service-toggle" data-commerce-event="add_shipping_info" role="tab" aria-selected="false">SHIPPING<small>add_shipping_info</small></button><button class="service-toggle" data-commerce-event="add_payment_info" role="tab" aria-selected="false">PAYMENT<small>add_payment_info</small></button><button class="service-toggle is-active" data-commerce-event="purchase" role="tab" aria-selected="true">PURCHASE<small>purchase</small></button></div>
  <div class="commerce-inspector mt-6" role="tabpanel" tabindex="0"><div><p class="service-kicker">EVENT</p><strong data-commerce-name>purchase</strong></div><div><p class="service-kicker">EXPECTED TRIGGER</p><strong data-commerce-trigger>confirmed order</strong></div><div><p class="service-kicker">KEY DATA</p><pre data-commerce-data>transaction_id: ORD-102847
value: 249.00
currency: AED
items: 2</pre></div><div><p class="service-kicker">UPSIGHT VALIDATES</p><p data-commerce-qa>Order confirmation, item array, reload behaviour and source-of-truth values.</p></div></div>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-border bg-background/50 p-4"><div><p class="font-semibold">Illustrative QA examples</p><p class="text-sm text-muted-foreground">Common issues are shown only when requested.</p></div><button class="service-toggle" data-issues aria-pressed="false">Show common tracking issues</button></div><pre class="mt-3 rounded-xl border border-border bg-background/50 p-4 font-mono text-sm" data-issues-output>Journey checks are available for the selected event.</pre>
  <details class="mt-6 rounded-xl border border-border bg-background/50 p-4"><summary class="cursor-pointer font-semibold">Inspect event payload</summary><pre class="event-payload"><code data-commerce-payload></code></pre></details>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-ecommerce-journey]');
  if (root) {
    const item = {item_id:'SKU-1001',item_name:'Performance Hoodie',item_brand:'Example Brand',item_category:'Apparel',item_variant:'Black / M',price:149,quantity:1};
    const events: Record<string, {trigger:string,data:string,qa:string,payload:object}> = {
      view_item:{trigger:'product detail viewed',data:'item_id: SKU-1001\nvalue: 149.00\ncurrency: AED\nitems: 1',qa:'Item identity, product detail timing, value and currency.',payload:{event:'view_item',ecommerce:{currency:'AED',value:149,items:[item]}}},
      add_to_cart:{trigger:'item added to cart',data:'item_id: SKU-1001\nvalue: 149.00\ncurrency: AED\nitems: 1',qa:'Item total, quantity, cart state and duplicate clicks.',payload:{event:'add_to_cart',ecommerce:{currency:'AED',value:149,items:[item]}}},
      begin_checkout:{trigger:'checkout begins',data:'value: 249.00\ncurrency: AED\nitems: 2',qa:'Checkout entry, items and any repeated firing.',payload:{event:'begin_checkout',ecommerce:{currency:'AED',value:249,items:[item]}}},
      add_shipping_info:{trigger:'shipping selection confirmed',data:'shipping_tier: Express\nvalue: 249.00\nitems: 2',qa:'Shipping selection timing and checkout state.',payload:{event:'add_shipping_info',ecommerce:{currency:'AED',value:249,shipping_tier:'Express',items:[item]}}},
      add_payment_info:{trigger:'payment method provided',data:'payment_type: card\nvalue: 249.00\nitems: 2',qa:'Payment step timing without exposing payment details.',payload:{event:'add_payment_info',ecommerce:{currency:'AED',value:249,payment_type:'card',items:[item]}}},
      purchase:{trigger:'confirmed order',data:'transaction_id: ORD-102847\nvalue: 249.00\ncurrency: AED\nitems: 2',qa:'Order confirmation, item array, reload behaviour and source-of-truth values.',payload:{event:'purchase',ecommerce:{transaction_id:'ORD-102847',value:249,tax:11.86,shipping:15,currency:'AED',coupon:'',items:[item,{item_id:'SKU-2048',item_name:'Analytics Cap',item_brand:'Example Brand',item_category:'Accessories',item_variant:'Black',price:100,quantity:1}]}}}
    }; let current = 'purchase'; let issues = false;
    const render = () => { const data = events[current]; root.querySelector('[data-commerce-name]')!.textContent = current; root.querySelector('[data-commerce-trigger]')!.textContent = data.trigger; root.querySelector('[data-commerce-data]')!.textContent = data.data; root.querySelector('[data-commerce-qa]')!.textContent = data.qa; root.querySelector('[data-commerce-payload]')!.textContent = JSON.stringify(data.payload,null,2); root.querySelectorAll<HTMLButtonElement>('[data-commerce-event]').forEach(button => {const active=button.dataset.commerceEvent===current;button.classList.toggle('is-active',active);button.setAttribute('aria-selected',String(active));}); root.querySelector('[data-issues-output]')!.textContent = issues ? 'view_item        item_id missing ✕\nadd_to_cart      value differs from item total ✕\nbegin_checkout   fires twice ✕\npurchase         transaction_id missing ✕\npurchase refresh purchase fires again ✕' : 'Journey checks are available for the selected event.'; };
    root.addEventListener('click', event => { const tab=(event.target as Element).closest<HTMLButtonElement>('[data-commerce-event]'); const issue=(event.target as Element).closest<HTMLButtonElement>('[data-issues]'); if(tab){current=tab.dataset.commerceEvent!;render();} if(issue){issues=!issues;issue.setAttribute('aria-pressed',String(issues));issue.textContent=issues?'Show valid journey':'Show common tracking issues';render();} }); render();
  }
</script>
