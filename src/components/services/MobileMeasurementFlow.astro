---
---
<section class="rounded-2xl border border-border bg-card p-5 md:p-8" aria-labelledby="mmp-flow-title"><p class="service-kicker">INTERACTIVE ATTRIBUTION FLOW</p><h2 id="mmp-flow-title" class="service-heading mt-2">Trace a campaign to an app outcome</h2>
<div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Select app platform">{['iOS','Android'].map((x,i)=><button type="button" data-platform={x} aria-pressed={i===0?'true':'false'} class="rounded-full border px-4 py-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">{x}</button>)}</div>
<div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Select attribution journey">{['New install','Re-engagement'].map((x,i)=><button type="button" data-journey={x} aria-pressed={i===0?'true':'false'} class="rounded-full border px-4 py-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">{x}</button>)}</div>
<div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Select deep-link state">{['Direct link','Deferred link'].map((x,i)=><button type="button" data-link={x} aria-pressed={i===0?'true':'false'} class="rounded-full border px-4 py-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">{x}</button>)}</div>
<ol id="mmp-journey" class="mt-7 grid gap-3 md:grid-cols-4"><li class="rounded-lg border p-4"><span class="service-kicker">01 · CAMPAIGN</span><p class="mt-2 font-semibold">Ad interaction</p><p class="mt-1 text-sm text-muted-foreground">Eligible click or view signal</p></li><li class="rounded-lg border p-4"><span class="service-kicker">02 · STORE</span><p class="mt-2 font-semibold">App install / open</p><p class="mt-1 text-sm text-muted-foreground" data-step-two>New install measurement</p></li><li class="rounded-lg border p-4"><span class="service-kicker">03 · APP</span><p class="mt-2 font-semibold">Deep-link destination</p><p class="mt-1 text-sm text-muted-foreground" data-step-three>Direct link opens the requested content</p></li><li class="rounded-lg border p-4"><span class="service-kicker">04 · OUTCOME</span><p class="mt-2 font-semibold">In-app event / postback</p><p class="mt-1 text-sm text-muted-foreground">Configured event routed to eligible partners</p></li></ol>
<p id="mmp-platform-note" class="mt-5 rounded-lg bg-muted/40 p-4 text-sm text-muted-foreground">iOS measurement behavior depends on privacy state, framework, platform configuration and available attribution signals. No setup restores unavailable deterministic data.</p></section>
<script>
  const selected: Record<string,string>={platform:'iOS',journey:'New install',link:'Direct link'};
  const refresh=()=>{const second=document.querySelector<HTMLElement>('[data-step-two]');const third=document.querySelector<HTMLElement>('[data-step-three]');const note=document.querySelector<HTMLElement>('#mmp-platform-note');if(second)second.textContent=selected.journey==='New install'?'New install measurement':'Existing install re-engagement';if(third)third.textContent=selected.link==='Direct link'?'Direct link opens requested content':'Deferred link resolves after install and first open, where supported';if(note)note.textContent=selected.platform==='iOS'?'iOS measurement behavior depends on privacy state, framework, platform configuration and available attribution signals. No setup restores unavailable deterministic data.':'Android attribution signals and referrer handling depend on store, SDK and partner configuration.'};
  [['[data-platform]','platform'],['[data-journey]','journey'],['[data-link]','link']].forEach(([selector,key])=>document.querySelectorAll<HTMLButtonElement>(selector).forEach((button)=>button.addEventListener('click',()=>{document.querySelectorAll<HTMLButtonElement>(selector).forEach(item=>{const on=item===button;item.setAttribute('aria-pressed',String(on));item.classList.toggle('bg-primary/10',on);item.classList.toggle('border-primary',on)});selected[key]=button.dataset.platform||button.dataset.journey||button.dataset.link||'';refresh()})));
</script>
