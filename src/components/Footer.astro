---
const year = new Date().getFullYear();
const services = [
  { href: '/services#server-side-tracking', label: 'Server-Side Tracking' },
  { href: '/services#meta-capi', label: 'Meta Conversions API' },
  { href: '/services#ecommerce-tracking', label: 'Ecommerce Tracking' },
  { href: '/services#analytics', label: 'Analytics Implementation' },
  { href: '/services/cookie-consent', label: 'Cookie Consent & CMP' },
  { href: '/services#dashboarding', label: 'Dashboarding & Reporting' },
];
---
<footer class="border-t border-border bg-card/50">
  <div class="container">
    <div class="grid gap-10 py-12 md:grid-cols-2 lg:grid-cols-4 lg:py-16">
      <div>
        <a href="/" aria-label="Upsight Digital home"><img src="/images/logo-optimized.webp" alt="Upsight Digital" class="mb-4 h-8 w-auto" width="151" height="32" loading="lazy" /></a>
        <p class="mb-5 max-w-sm text-sm leading-6 text-muted-foreground">Analytics experts trusted by startups, agencies, and brands across 10+ countries.</p>
        <div class="flex gap-3">
          <a href="https://www.linkedin.com/company/upsight-digital" target="_blank" rel="noopener noreferrer" class="rounded-md border border-border p-2 transition-colors hover:border-primary hover:text-primary" aria-label="LinkedIn">in</a>
          <a href="https://www.facebook.com/upsightdigital" target="_blank" rel="noopener noreferrer" class="rounded-md border border-border p-2 transition-colors hover:border-primary hover:text-primary" aria-label="Facebook">f</a>
        </div>
      </div>

      <div>
        <h2 class="mb-4 text-sm font-semibold">Quick Links</h2>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li><a class="hover:text-primary" href="/">Home</a></li><li><a class="hover:text-primary" href="/services">Services</a></li><li><a class="hover:text-primary" href="/who-its-for">Who It's For</a></li><li><a class="hover:text-primary" href="/process">Process</a></li><li><a class="hover:text-primary" href="/about">About</a></li><li><a class="hover:text-primary" href="/case-studies">Case Studies</a></li>
        </ul>
      </div>

      <div>
        <h2 class="mb-4 text-sm font-semibold">Services</h2>
        <ul class="space-y-3 text-sm text-muted-foreground">{services.map((service) => <li><a class="hover:text-primary" href={service.href}>{service.label}</a></li>)}</ul>
      </div>

      <div>
        <h2 class="mb-4 text-sm font-semibold">Get In Touch</h2>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li><a class="hover:text-primary" href="mailto:team@upsight.digital">team@upsight.digital</a></li>
          <li><a class="hover:text-primary" href="tel:+971568525950">+971-56-8525950</a></li>
          <li>Dubai, UAE</li>
        </ul>
        <a href="/contact" class="mt-5 inline-flex h-9 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90">Book Consultation</a>
      </div>
    </div>
    <div class="flex flex-col items-center justify-between gap-4 border-t border-border py-6 md:flex-row">
      <p class="text-sm text-muted-foreground">© {year} Upsight Digital. All rights reserved.</p>
      <div class="flex flex-wrap justify-center gap-4 text-sm text-muted-foreground"><span>7+ Years of Expertise</span><span>120+ Clients</span><span>10+ Countries</span></div>
    </div>
  </div>
</footer>
