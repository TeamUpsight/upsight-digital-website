---
interface Link { label: string; href: string; }
interface Faq { question: string; answer: string; }
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  suitableFor: string[];
  implementation: string[];
  workflow: string[];
  validation: string[];
  limitations: string[];
  faqs: Faq[];
  proof?: Link[];
  related: Link[];
  primaryCta?: string;
}
const { eyebrow, title, intro, suitableFor, implementation, workflow, validation, limitations, faqs, proof = [], related, primaryCta = 'Discuss this service' } = Astro.props;
---
<div class="min-h-screen">
  <section class="bg-muted/30 pb-16 pt-32 md:pb-24 md:pt-40">
    <div class="container max-w-4xl text-center">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-primary">{eyebrow}</p>
      <h1 class="heading-xl mb-6">{title}</h1>
      <p class="body-lg mx-auto max-w-3xl text-muted-foreground">{intro}</p>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
        <a href="/contact/" class="inline-flex h-12 items-center justify-center rounded-md bg-[#008466] px-8 text-base font-semibold text-white transition-colors hover:bg-[#007A5E]">{primaryCta}</a>
        <a href="/health-check/" class="inline-flex h-12 items-center justify-center rounded-md border border-primary px-8 text-base font-semibold text-primary transition-colors hover:bg-primary/10">Take the free Health Check</a>
      </div>
    </div>
  </section>

  <section class="section-spacing"><div class="container grid gap-12 lg:grid-cols-2">
    <div><h2 class="heading-md mb-5">When this service is useful</h2><ul class="space-y-3 text-muted-foreground">{suitableFor.map((item) => <li class="flex gap-3"><span class="text-primary">•</span><span>{item}</span></li>)}</ul></div>
    <div><h2 class="heading-md mb-5">What we implement</h2><ul class="space-y-3 text-muted-foreground">{implementation.map((item) => <li class="flex gap-3"><span class="text-primary">•</span><span>{item}</span></li>)}</ul></div>
  </div></section>

  <section class="section-spacing bg-muted/30"><div class="container max-w-5xl"><h2 class="heading-md mb-8 text-center">A practical implementation process</h2><ol class="grid gap-5 md:grid-cols-2">{workflow.map((item, index) => <li class="rounded-xl border border-border bg-background p-6"><span class="text-sm font-semibold text-primary">0{index + 1}</span><p class="mt-3 text-muted-foreground">{item}</p></li>)}</ol></div></section>

  <section class="section-spacing"><div class="container grid gap-12 lg:grid-cols-2">
    <div><h2 class="heading-md mb-5">How we validate the work</h2><ul class="space-y-3 text-muted-foreground">{validation.map((item) => <li class="flex gap-3"><span class="text-primary">•</span><span>{item}</span></li>)}</ul></div>
    <div><h2 class="heading-md mb-5">What this does not solve on its own</h2><ul class="space-y-3 text-muted-foreground">{limitations.map((item) => <li class="flex gap-3"><span class="text-primary">•</span><span>{item}</span></li>)}</ul></div>
  </div></section>

  {proof.length > 0 && <section class="section-spacing bg-muted/30"><div class="container max-w-4xl"><h2 class="heading-md mb-5">Relevant implementation evidence</h2><p class="mb-5 text-muted-foreground">Our case studies show the implementation context and outcomes for specific engagements; they are not blanket performance promises.</p><div class="flex flex-wrap gap-4">{proof.map((link) => <a href={link.href} class="font-semibold text-primary underline underline-offset-4">{link.label}</a>)}</div></div></section>}

  <section class="section-spacing"><div class="container max-w-4xl"><h2 class="heading-md mb-8">Implementation questions</h2><div class="space-y-4">{faqs.map((faq) => <details class="rounded-xl border border-border p-5"><summary class="cursor-pointer font-semibold">{faq.question}</summary><p class="mt-4 leading-7 text-muted-foreground">{faq.answer}</p></details>)}</div></div></section>

  <section class="section-spacing bg-muted/30"><div class="container max-w-4xl text-center"><h2 class="heading-md mb-5">Related services</h2><div class="flex flex-wrap justify-center gap-x-6 gap-y-3">{related.map((link) => <a href={link.href} class="font-semibold text-primary underline underline-offset-4">{link.label}</a>)}</div><a href="/contact/" class="mt-9 inline-flex h-12 items-center justify-center rounded-md bg-[#008466] px-8 font-semibold text-white transition-colors hover:bg-[#007A5E]">{primaryCta}</a></div></section>
</div>
