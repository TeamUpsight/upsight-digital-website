---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import MobileAnalyticsExplorer from '../../components/services/MobileAnalyticsExplorer.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import { serviceSchema } from '../../lib/seo';
import { selectTechnologies } from '../../lib/technologies';
const vendors = selectTechnologies(['firebaseAnalytics','amplitude','mixpanel','posthog']);
---
<BaseLayout title="Mobile Analytics Implementation | Upsight Digital" description="Implement governed mobile product analytics across Firebase Analytics, Amplitude, Mixpanel, PostHog and other platforms, including events, identity, funnels, retention, cohorts, replay, experimentation and QA." canonical="https://upsight.digital/services/mobile-analytics/" jsonLd={serviceSchema('Mobile Analytics Implementation', 'Mobile product analytics implementation, event architecture, identity, SDK configuration, product analysis and quality assurance.', '/services/mobile-analytics/')}>
  <ServiceHero eyebrow="MOBILE PRODUCT ANALYTICS" title="Mobile Analytics Implementation" lead="Turn every important in-app action into a measurement model your product, marketing and analytics teams can use." detail="Upsight designs the event architecture, integrates the analytics SDK, defines user and event properties, configures product-analysis features and validates implementation across iOS, Android and supported cross-platform frameworks." primaryLabel="Plan My Mobile Analytics"><div slot="visual" class="rounded-xl border border-primary/30 bg-card p-5 font-mono text-sm"><p class="service-kicker">ILLUSTRATIVE APP SESSION</p><p class="mt-3 leading-7">App Open → Onboarding Started → Account Created → Feature Used → Subscription Started</p><div class="mt-4 grid grid-cols-2 gap-3"><p class="rounded border p-3">event<br /><strong>subscription_started</strong><br />user_id: u_28471</p><p class="rounded border p-3">plan: premium<br />platform: iOS<br />source: onboarding</p></div><p class="mt-4 text-primary">Activation funnel · illustrative 72%<br />Week 4 cohort · illustrative 38%</p><p class="mt-2 text-xs text-muted-foreground">Example values only, not client results.</p></div></ServiceHero>
  <div class="container py-10 md:py-16"><MobileAnalyticsExplorer /></div>
  <section id="identity-architecture" class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">IDENTITY &amp; LIFECYCLE</p><h2 class="service-heading mt-3">Events Are Only Useful When Identity Is Designed Properly</h2><p class="mt-4 max-w-3xl leading-7 text-muted-foreground">We specify how anonymous app activity, sign-in, account changes and lifecycle events should be represented. Identity behavior is platform-specific and must be validated against product requirements, privacy choices and each SDK's rules.</p><div class="mt-6 grid gap-4 md:grid-cols-3">{[['Anonymous activity','Define how pre-login app activity is represented and whether it may be associated after sign-in.'],['Authenticated identity','Set rules for stable user identifiers, account switching, logout and shared devices.'],['Lifecycle and consent','Map subscription or membership state and ensure collection follows applicable consent settings.']].map(([h,d])=><article class="service-proof-card"><h3>{h}</h3><p>{d}</p></article>)}</div></div></section>
  <section class="py-12 md:py-16"><div class="container"><p class="service-kicker">PRODUCT ANALYSIS</p><h2 class="service-heading mt-3">A Governed Mobile Analytics Layer</h2><div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{[['Event architecture','Naming conventions, event properties, shared definitions and lifecycle states.'],['User identity','Device, anonymous and signed-in ID rules, where supported by the chosen SDK.'],['Funnels and journeys','Measure onboarding, feature use and conversion steps against agreed events.'],['Retention and cohorts','Define return behavior and useful segments with clear date and cohort logic.'],['Advanced features','Session replay, experiments, feature flags and audiences where supported and configured.'],['Data export and integration','Map approved analytics events to backend, warehouse, BI or other systems.'],['SDK and data quality QA','Validate platform coverage, payloads, duplicate events, edge states and release behavior.']].map(([h,d])=><article class="service-proof-card"><h3>{h}</h3><p>{d}</p></article>)}</div></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">PLATFORM OPTIONS</p><h2 class="service-heading mt-3">Choose a Platform Around the Product Questions</h2><p class="mt-4 max-w-3xl leading-7 text-muted-foreground">Capabilities vary by SDK, platform, product configuration and plan. We document the requirements first, then configure and verify the supported features relevant to the app.</p><div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{vendors.map((v)=><article class="service-proof-card flex flex-col items-start"><img src={v.logo} alt={`${v.name} logo`} width="160" height="48" class:list={['h-12 w-40 object-contain object-left',v.key==='posthog'?'rounded bg-white p-1':'']} loading="lazy"/><h3 class="mt-3">{v.name}</h3><p class="mt-2 text-sm">Mobile event and user-property setup is scoped to the chosen product and supported SDK.</p></article>)}</div></div></section>
  <section class="py-12 md:py-16"><div class="container"><p class="service-kicker">IMPLEMENTATION QA</p><h2 class="service-heading mt-3">Validate the App, Not Just the Dashboard</h2><div class="mt-6 grid gap-4 md:grid-cols-2">{[['Build coverage','Confirm expected behavior on supported iOS and Android builds and agreed app frameworks.'],['Payload contract','Compare emitted event names, properties, types and identifiers to the implementation specification.'],['Journey edge cases','Exercise reinstall, logout, account change, offline use and subscription state transitions.'],['Release checks','Document environment, consent behavior, duplicate handling and sign-off evidence.']].map(([h,d])=><article class="service-proof-card"><h3>{h}</h3><p>{d}</p></article>)}</div><p class="mt-6 text-sm text-muted-foreground">For campaign attribution and MMP configuration, see <a class="text-primary underline" href="/services/mobile-measurement/">Mobile Measurement</a>. For system-level event and identity design, see <a class="text-primary underline" href="/services/measurement-planning/">Measurement Planning &amp; Architecture Design</a>, <a class="text-primary underline" href="/services/analytics-dashboards/">Analytics Dashboards</a> and <a class="text-primary underline" href="/services/tracking-audit/">Tracking Audit</a>.</p></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><h2 class="service-heading">Common Questions</h2><div class="mt-5 grid gap-3">{[['How is mobile analytics different from mobile attribution?','Mobile analytics explains in-app behavior such as onboarding, feature use, retention and subscriptions. Mobile attribution connects eligible campaign interactions to installs or app outcomes through an MMP and platform-specific measurement.'],['Do we need an SDK?','Most app analytics setups collect through a vendor SDK or an agreed server/API route. The right approach depends on platform support, data needs and app architecture.'],['Can one event model serve analytics and marketing?','A shared governed event contract can inform multiple destinations, but platform-specific mapping and privacy rules still need separate configuration and QA.'],['Are replay and experiments included on every platform?','No. Availability depends on vendor, product, SDK, plan and configuration. We verify requirements and scope before implementation.']].map(([q,a])=><details class="rounded-lg border bg-card p-4"><summary class="cursor-pointer font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">{q}</summary><p class="mt-3 text-sm leading-6 text-muted-foreground">{a}</p></details>)}</div></div></section>
  <ServiceCTA title="Build an app analytics layer teams can use." detail="Start with the product questions, event model and identity requirements, then validate the SDK implementation against them." primaryLabel="Plan My Mobile Analytics" />
</BaseLayout>
