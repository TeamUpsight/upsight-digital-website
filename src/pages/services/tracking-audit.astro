---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import AuditWorkspace from '../../components/services/AuditWorkspace.astro';
import ServiceProofCard from '../../components/services/ServiceProofCard.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import { serviceSchema } from '../../lib/seo';
---
<BaseLayout title="Digital Analytics & Tracking Audit | Upsight Digital" description="Audit GA4, GTM, ecommerce tracking, conversion events, consent behavior and advertising integrations with evidence-backed findings and a prioritized remediation plan." jsonLd={serviceSchema('Digital Analytics & Tracking Audit', 'Technical analytics audits covering GA4, GTM, ecommerce tracking, conversion events, consent behaviour, and remediation planning.', '/services/tracking-audit/')}>
  <ServiceHero eyebrow="MEASUREMENT QA" title="Digital Analytics & Tracking Audit" lead="Find out what your analytics implementation is actually recording, what it is missing, and where the data becomes unreliable." detail="Upsight reviews events, parameters, data layers, tags, consent behavior, ecommerce journeys, and advertising integrations—then provides evidence and a prioritized remediation plan." primaryLabel="Request a Tracking Audit" secondaryLabel="View Example Audit" secondaryHref="#audit-example"><div slot="visual" class="font-mono text-sm leading-7"><p class="service-kicker">AUDIT: Ecommerce Measurement</p><p class="mt-3">Environment: Production</p><p class="text-primary">Status: 8 findings</p><p class="mt-4 rounded border border-destructive/40 p-3">CRITICAL<br /><span class="text-xs text-muted-foreground">purchase refresh duplicates</span></p></div></ServiceHero>
  <div id="audit-example" class="container py-10 md:py-16"><AuditWorkspace /></div>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container max-w-5xl"><p class="service-kicker">THE OUTPUT</p><h2 class="service-heading mt-3">An Audit Should Leave You With Evidence, Not Just a Score</h2><p class="mt-5 max-w-3xl leading-7 text-muted-foreground">A score can indicate that something may be wrong. A technical audit should show where it is wrong, how it was verified, what measurement it affects, what needs to change, and who needs to change it.</p><p class="mt-6 font-mono text-sm text-primary">Finding → Evidence → Impact → Recommendation → Owner → Priority → Validation status</p></div></section>
  <section class="py-12 md:py-16"><div class="container"><h2 class="service-heading">What We Review</h2><div class="mt-6 grid gap-4 md:grid-cols-3">{[['Measurement architecture','GA4 properties, streams, strategy, events, conversion definitions.'],['GTM and data layer','Container structure, triggers, variables, duplicate tags, data-layer events, ownership.'],['Ecommerce','Product, cart, checkout, purchase, items, transaction IDs, revenue, currency.'],['Advertising','Google Ads, Meta Pixel/CAPI, TikTok, Snapchat, and agreed destinations.'],['Consent','CMP behavior, Consent Mode, GTM consent checks, pre-consent firing, propagation.'],['Reporting consistency','Observable source mismatches, missing or duplicate events, unexpected attribution behavior.']].map(([title,detail]) => <article class="service-proof-card"><h3>{title}</h3><p>{detail}</p></article>)}</div></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><h2 class="service-heading">How the Audit Works</h2><ol class="mt-6 grid gap-3 md:grid-cols-3 lg:grid-cols-6">{[['01','Scope','Agree platforms, journeys, environments, access.'],['02','Observe','Inspect implementation and behavior.'],['03','Reproduce','Run journeys and edge cases.'],['04','Document','Capture evidence and findings.'],['05','Prioritize','Separate failures from cleanup.'],['06','Validate','Retest included fixes.']].map(([n,t,d]) => <li class="service-proof-card"><p class="font-mono text-primary">{n}</p><h3 class="mt-2">{t}</h3><p>{d}</p></li>)}</ol></div></section>
  <section class="py-12 md:py-16"><div class="container grid gap-6 lg:grid-cols-2"><div><h2 class="service-heading">What Your Team Receives</h2><ul class="mt-5 space-y-2 text-muted-foreground"><li>Executive findings summary</li><li>Detailed issue register and evidence</li><li>Severity, ownership, and developer-ready recommendations</li><li>Implementation roadmap and QA/retest status</li></ul></div><ServiceProofCard metric="122 obsolete UA tags removed" title="Roadsurfer remediation evidence" detail="The approved Roadsurfer case study covers a 320+ tag review, GA4 consolidation, attribution corrections, and ecommerce data-layer work." href="/case-studies/roadsurfer/" /></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container max-w-5xl"><h2 class="service-heading">Quick orientation or technical investigation?</h2><div class="mt-6 overflow-hidden rounded-xl border border-border"><table class="w-full text-left text-sm"><thead class="bg-card"><tr><th class="p-3"></th><th class="p-3">Free Health Check</th><th class="p-3">Technical Tracking Audit</th></tr></thead><tbody class="text-muted-foreground"><tr><td class="p-3 font-semibold text-foreground">Format</td><td class="p-3">Guided self-assessment</td><td class="p-3">Hands-on technical review</td></tr><tr><td class="p-3 font-semibold text-foreground">Inputs</td><td class="p-3">Your answers</td><td class="p-3">Implementation evidence</td></tr><tr><td class="p-3 font-semibold text-foreground">Event testing</td><td class="p-3">No</td><td class="p-3">Yes, within scope</td></tr><tr><td class="p-3 font-semibold text-foreground">Output</td><td class="p-3">General recommendations</td><td class="p-3">Finding-level evidence and priorities</td></tr></tbody></table></div></div></section>
  <ServiceCTA title="Move from uncertainty to a prioritized technical plan." detail="Start with a free orientation or request a hands-on audit of the agreed implementation scope." primaryLabel="Request a Tracking Audit" secondaryLabel="Start With the Free Health Check" />
</BaseLayout>
