---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import EventJourneyInspector from '../../components/services/EventJourneyInspector.astro';
import ServiceProofCard from '../../components/services/ServiceProofCard.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import { serviceSchema } from '../../lib/seo';
---
<BaseLayout title="GA4 & Google Tag Manager Implementation | Upsight Digital" description="Plan and implement GA4 and Google Tag Manager with measurement strategy, event taxonomy, data-layer requirements, key conversions, QA and documentation." jsonLd={serviceSchema('GA4 & Google Tag Manager Implementation', 'GA4 and GTM implementation including measurement strategy, event taxonomy, data-layer requirements, key conversions, QA, and documentation.', '/services/ga4-gtm-setup/')}>
  <ServiceHero eyebrow="MEASUREMENT FOUNDATION" title="GA4 & Google Tag Manager Implementation" lead="Build an analytics implementation your developers, marketers, and analysts can understand and trust." detail="Upsight turns business journeys into a documented measurement plan, data layer, GA4 event model, and governed GTM implementation—then validates critical events before handover." primaryLabel="Plan My Analytics Setup"><div slot="visual" class="font-mono text-sm leading-7"><p class="service-kicker">EVENT PREVIEW</p><p class="mt-3">checkout completed</p><p class="text-primary">↓ data layer</p><p>event: purchase<br />transaction_id: 102847<br />value: 249.00</p><p class="text-primary">↓ GTM → GA4</p><p class="rounded border border-primary/40 bg-primary/10 p-3">Revenue · Transactions · Products</p></div></ServiceHero>
  <div id="event-example" class="container py-10 md:py-16"><EventJourneyInspector /></div>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container max-w-5xl"><p class="service-kicker">MEASUREMENT DESIGN</p><h2 class="service-heading mt-3">A Good GTM Container Starts Before GTM</h2><p class="mt-5 max-w-3xl leading-7 text-muted-foreground">Installing GA4 is easy. Designing an implementation that gives different teams a consistent understanding of the customer journey is harder. We define the measurement model first, then use GA4 and GTM to implement it.</p><p class="mt-6 font-mono text-sm text-primary">Business Questions → Customer Journeys → KPIs → Events → Parameters → Data Layer → GTM → GA4 &amp; Destinations → QA</p></div></section>
  <section class="py-12 md:py-16"><div class="container"><h2 class="service-heading">What Upsight Implements</h2><div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{[['Measurement plan','Business questions, KPIs, journeys, events, parameters, conversion definitions.'],['Data layer','Developer requirements, event naming, object structure, ecommerce objects, contextual parameters.'],['GTM','Tags, triggers, variables, folders, naming conventions, environments, consent configuration.'],['GA4','Data streams, events, key events, dimensions, referral and cross-domain settings where applicable.'],['Documentation','Tracking specifications, developer instructions, QA evidence, handover, governance.']].map(([title,detail]) => <article class="service-proof-card"><h3>{title}</h3><p>{detail}</p></article>)}</div></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container grid gap-8 lg:grid-cols-[.85fr_1.15fr]"><div><p class="service-kicker">DELIVERY WORKFLOW</p><h2 class="service-heading mt-3">Developer ↔ Analytics Workflow</h2></div><div><p class="leading-7 text-muted-foreground">We work between business, marketing, and development teams. Requirements are translated into developer-ready specifications, implementations are validated against those requirements, and QA evidence is retained so tracking does not become guesswork after every release.</p><p class="mt-6 font-mono text-sm text-primary">Business / Marketing → Upsight specification → Development → QA test logs → Upsight validation → Production → Monitoring</p></div></div></section>
  <section class="py-12 md:py-16"><div class="container"><div class="grid gap-5 md:grid-cols-2"><ServiceProofCard metric="5 GA4 properties consolidated" title="Roadsurfer" detail="The approved Roadsurfer case study includes a GTM review, 122 obsolete Universal Analytics tags removed, and ecommerce structure work." href="/case-studies/roadsurfer/" /><ServiceProofCard title="Slice" detail="Slice demonstrates the value of disciplined event structure, server-side delivery, and measurement validation." href="/case-studies/slice/" /></div><p class="mt-5 text-sm text-muted-foreground">Related implementation paths: <a class="text-primary underline" href="/services/ecommerce-tracking/">Ecommerce Tracking</a>, <a class="text-primary underline" href="/services/server-side-tracking/">Server-Side Tracking</a>, and <a class="text-primary underline" href="/services/tracking-audit/">Tracking Audit</a>.</p></div></section>
  <ServiceCTA title="Turn journeys and KPIs into a governed implementation." detail="Start with a new measurement plan or a review of the GA4 and GTM setup you already own." primaryLabel="Plan My Analytics Setup" secondaryLabel="Review an Existing Implementation" />
</BaseLayout>
