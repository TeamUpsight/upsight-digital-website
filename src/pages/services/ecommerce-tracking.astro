---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import EcommerceJourney from '../../components/services/EcommerceJourney.astro';
import ServiceProofCard from '../../components/services/ServiceProofCard.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import { serviceSchema } from '../../lib/seo';
const groups = [['Journey measurement','Product discovery, product detail, cart, checkout, purchase, and refunds where scoped.'],['Product data','item_id, item_name, brand, category, variant, price, and quantity.'],['Order data','Transaction ID, revenue/value, currency, tax, shipping, and coupon.'],['Data delivery','GA4, Google Ads, Meta, and server-side routes where applicable.'],['QA','Real test orders, reload behaviour, duplicate protection, item arrays, order reconciliation, and consent states.']];
const faqs = [['Do you support Shopify?','Yes. The implementation depends on the theme, apps, checkout architecture, and data-layer access.'],['Do you support WooCommerce?','Yes. We scope the implementation around plugins, templates, checkout behaviour, and the final order source.'],['Can you implement custom ecommerce tracking?','Yes, where the required commerce and product data can be made available in the agreed architecture.'],['Why does GA4 revenue sometimes differ from the ecommerce platform?','Systems can differ in timing, currencies, refunds, attribution, and processing. We validate the agreed measurement path and document known differences.'],['How do you prevent duplicate purchases?','A stable transaction identifier and appropriate duplicate protection help prevent repeated web-purchase recording.'],['Can the same events feed advertising platforms?','Where scoped, the same documented commerce model can feed agreed destinations with their own requirements.'],['Do you test refunds?','Refund handling can be included when it is within the agreed event model and source-system scope.'],['Can tracking work across external checkout or payment domains?','Often, but the implementation depends on the checkout flow, domain access, and platform constraints.']];
---
<BaseLayout title="Ecommerce Tracking Implementation | Upsight Digital" description="Implement GA4 ecommerce tracking across product, cart, checkout and purchase journeys with structured item data, transaction IDs, QA, and order reconciliation." jsonLd={serviceSchema('Ecommerce Tracking Implementation', 'Ecommerce measurement implementation across product, cart, checkout, purchase, item data, transaction IDs, QA, and order reconciliation.', '/services/ecommerce-tracking/')}>
  <ServiceHero eyebrow="ECOMMERCE MEASUREMENT" title="Ecommerce Tracking Implementation" lead="Track the complete journey from product discovery to a verified order." detail="Upsight designs the ecommerce data layer, GA4 event model, purchase logic, product parameters and downstream conversion tracking, then validates the implementation against real commerce behaviour." primaryLabel="Review My Ecommerce Tracking"><div slot="visual" class="font-mono text-sm leading-7"><p class="service-kicker">PURCHASE PATH</p><p class="mt-3">Product <span class="text-primary">→</span> Cart <span class="text-primary">→</span> Checkout <span class="text-primary">→</span> Purchase</p><p class="mt-4 rounded border border-primary/40 bg-primary/10 p-3">transaction_id: #102847<br />value: 249.00 AED<br />items: 2</p></div></ServiceHero>
  <div class="container py-10 md:py-16"><EcommerceJourney /></div>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container grid gap-8 lg:grid-cols-2"><div><p class="service-kicker">PURCHASE SAFETY</p><h2 class="service-heading mt-3">One Order Should Still Be One Order</h2><p class="mt-4 leading-7 text-muted-foreground">A stable transaction identifier and appropriate duplicate protection help prevent the same web purchase from being recorded repeatedly.</p></div><pre class="service-panel font-mono text-sm leading-7">Order confirmation
ORD-102847

Page load      → purchase
Refresh        → purchase?
Back/forward   → purchase?
Retry          → purchase?</pre></div></section>
  <section class="py-12 md:py-16"><div class="container max-w-5xl"><p class="service-kicker">SOURCE-OF-TRUTH QA</p><h2 class="service-heading mt-3">We Validate Against the Order, Not Just the Tag</h2><div class="mt-6 overflow-x-auto rounded-xl border border-border"><table class="w-full text-left text-sm"><thead class="bg-muted/30"><tr><th scope="col" class="p-3">Commerce system</th><th scope="col" class="p-3"><span class="sr-only">Compare values</span></th><th scope="col" class="p-3">Tracking payload</th></tr></thead><tbody class="text-muted-foreground"><tr><th scope="row" class="p-3 text-foreground">Order ID<br />ORD-102847</th><td class="p-3 text-primary">↔</td><td class="p-3">transaction_id<br />ORD-102847</td></tr><tr><th scope="row" class="p-3 text-foreground">Currency<br />AED</th><td class="p-3 text-primary">↔</td><td class="p-3">currency<br />AED</td></tr><tr><th scope="row" class="p-3 text-foreground">Revenue<br />249.00</th><td class="p-3 text-primary">↔</td><td class="p-3">value<br />249.00</td></tr><tr><th scope="row" class="p-3 text-foreground">Products<br />SKU-1001 · SKU-2048</th><td class="p-3 text-primary">↔</td><td class="p-3">items[]<br />2 items</td></tr></tbody></table></div></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">IMPLEMENTATION SCOPE</p><h2 class="service-heading mt-3">What Upsight Builds</h2><div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{groups.map(([title,detail]) => <article class="service-proof-card"><h3>{title}</h3><p>{detail}</p></article>)}</div><div class="mt-8 grid gap-4 md:grid-cols-3"><article class="service-proof-card"><h3>Shopify</h3><p>Scope around the theme, apps, checkout, and platform data available.</p></article><article class="service-proof-card"><h3>WooCommerce</h3><p>Scope around plugins, templates, order ownership, and data-layer access.</p></article><article class="service-proof-card"><h3>Custom ecommerce</h3><p>Scope around the implementation, backend, checkout, and developer integration points.</p></article></div><p class="mt-5 max-w-4xl text-sm leading-6 text-muted-foreground">The event model is consistent, but the implementation path depends on checkout architecture, theme/app integrations, data-layer access, payment flow, consent configuration, and the system that owns the final order.</p></div></section>
  <section class="py-12 md:py-16"><div class="container grid gap-5 md:grid-cols-2"><ServiceProofCard metric="122 obsolete UA tags removed" title="Roadsurfer ecommerce measurement" detail="The approved Roadsurfer case study covers a 320+ tag review, GA4 consolidation, attribution corrections, and ecommerce data-layer work." href="/case-studies/roadsurfer/" /><div class="service-proof-card"><p class="service-kicker">RELATED IMPLEMENTATION</p><h2 class="mt-2 text-xl font-semibold">A purchase model is stronger when its foundations are clear</h2><p class="mt-3 text-sm text-muted-foreground">Connect this work with a <a class="text-primary underline" href="/services/ga4-gtm-setup/">GA4 &amp; GTM implementation</a>, <a class="text-primary underline" href="/services/tracking-audit/">Tracking Audit</a>, or <a class="text-primary underline" href="/services/server-side-tracking/">Server-Side Tracking</a>.</p></div></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container max-w-4xl"><h2 class="service-heading">Ecommerce tracking questions</h2><div class="mt-5 space-y-3">{faqs.map(([q,a]) => <details class="rounded border border-border p-4"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-3 text-sm leading-6 text-muted-foreground">{a}</p></details>)}</div></div></section>
  <ServiceCTA title="Make Your Purchase Data Traceable From Product to Order" detail="Bring the commerce platform, checkout journey, and reporting questions that need a dependable source of truth." primaryLabel="Review My Ecommerce Tracking" secondaryLabel="Explore GA4 & GTM" secondaryHref="/services/ga4-gtm-setup/" />
</BaseLayout>
