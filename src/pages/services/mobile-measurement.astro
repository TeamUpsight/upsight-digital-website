---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import MobileMeasurementFlow from '../../components/services/MobileMeasurementFlow.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import { serviceSchema } from '../../lib/seo';
import { selectTechnologies } from '../../lib/technologies';
const vendors=selectTechnologies(['appsflyer','adjust','branch','kochava']);
---
<BaseLayout title="Mobile Measurement & MMP Implementation | Upsight Digital" description="Implement mobile measurement and MMP attribution across AppsFlyer, Adjust, Branch, Kochava and other supported platforms, including installs, re-engagement, deep links, in-app events and QA." canonical="https://upsight.digital/services/mobile-measurement/" jsonLd={serviceSchema('Mobile Measurement and MMP Implementation', 'Mobile attribution implementation including MMP configuration, app events, deep links, partner integrations, privacy-era measurement and QA.', '/services/mobile-measurement/')}>
  <ServiceHero eyebrow="MOBILE ATTRIBUTION" title="Mobile Measurement & MMP Implementation" lead="Connect eligible campaign interactions to installs, re-engagement and downstream app conversions." detail="Upsight plans and implements mobile measurement partner configuration, SDK events, deep links, partner integrations and validation across the app, MMP and advertising destinations. Attribution availability depends on platform, privacy state, partner rules and implementation." primaryLabel="Plan My Mobile Measurement"><div slot="visual" class="rounded-xl border border-primary/30 bg-card p-5 font-mono text-sm"><p class="service-kicker">ILLUSTRATIVE JOURNEY</p><p class="mt-4 leading-8">Campaign touch<br /><span class="text-primary">↓</span><br />Store / app open<br /><span class="text-primary">↓</span><br />Deep-link destination<br /><span class="text-primary">↓</span><br />In-app event → partner postback</p><p class="mt-3 text-xs text-muted-foreground">Available signals and matching depend on privacy and partner configuration.</p></div></ServiceHero>
  <div class="container py-10 md:py-16"><MobileMeasurementFlow /></div>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">IOS PRIVACY MEASUREMENT</p><h2 class="service-heading mt-3">Mobile Measurement After ATT</h2><p class="mt-4 max-w-4xl leading-7 text-muted-foreground">iOS measurement can combine consented identifiers where available with privacy-preserving attribution frameworks and aggregated signals. The exact options depend on the app, OS version, user choice, ad platform and MMP configuration. We define expected reporting limits up front; implementation cannot recover signals that a platform does not make available.</p><div class="mt-6 grid gap-4 md:grid-cols-3">{[['Consent-aware identifiers','Use identifiers only when collection and use are permitted and technically available.'],['Privacy-preserving frameworks','Configure the relevant framework and conversion mapping where the app and partners support it.'],['Reconciliation expectations','Document differences between app, MMP, ad-platform and backend totals instead of promising exact matches.']].map(([h,d])=><article class="service-proof-card"><h3>{h}</h3><p>{d}</p></article>)}</div></div></section>
  <section class="py-12 md:py-16"><div class="container"><p class="service-kicker">IMPLEMENTATION SCOPE</p><h2 class="service-heading mt-3">What an MMP Implementation Covers</h2><div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{[['SDK integration','App setup, environment configuration and app lifecycle checks.'],['Acquisition and re-engagement','Install, reinstall and re-engagement attribution definitions where supported.'],['In-app conversion events','Map meaningful app outcomes and event properties to the MMP contract.'],['Deep and deferred deep links','Test direct routing and post-install content resolution where supported.'],['Partner integrations','Configure ad-network connections, event mappings and postbacks as agreed.'],['Revenue measurement','Map purchase/subscription value and currency with backend reconciliation.'],['Raw data and APIs','Define export or API requirements, identifiers, access and downstream use.'],['Attribution QA','Validate install and event paths, consent states, duplicate handling and partner diagnostics.']].map(([h,d])=><article class="service-proof-card"><h3>{h}</h3><p>{d}</p></article>)}</div></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">MMP OPTIONS</p><h2 class="service-heading mt-3">Implementation Across Supported MMPs</h2><div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{vendors.map(v=><article class="service-proof-card"><img src={v.logo} alt={`${v.name} logo`} width="160" height="48" class:list={['h-12 w-40 object-contain object-left',v.key==='posthog'?'rounded bg-white p-1':'']} loading="lazy"/><h3 class="mt-3">{v.name}</h3><p class="mt-2 text-sm">Configuration and partner capabilities vary by product, plan, app platform and integration.</p></article>)}</div></div></section>
  <section id="mmp-qa" class="py-12 md:py-16"><div class="container"><p class="service-kicker">QA SCENARIOS</p><h2 class="service-heading mt-3">Test the Journeys People Actually Take</h2><div class="mt-6 grid gap-4 md:grid-cols-2">{[['Install and first open','Test campaign context, first launch, MMP event receipt and destination mapping.'],['Reinstall and re-engagement','Check expected behavior for returning users and app-open campaigns.'],['Deep-link variants','Test direct and deferred links across installed and not-installed states.'],['Privacy and postbacks','Validate consent states, partner eligibility, event delivery and documented reporting constraints.']].map(([h,d])=><article class="service-proof-card"><h3>{h}</h3><p>{d}</p></article>)}</div><p class="mt-6 text-sm text-muted-foreground">For in-app product behavior, see <a class="text-primary underline" href="/services/mobile-analytics/">Mobile Analytics</a>. For app-wide system design, see <a class="text-primary underline" href="/services/measurement-planning/">Measurement Planning &amp; Architecture Design</a>, <a class="text-primary underline" href="/services/server-side-tracking/">Server-Side Tracking</a> and <a class="text-primary underline" href="/services/tracking-audit/">Tracking Audit</a>.</p></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><h2 class="service-heading">Common Questions</h2><div class="mt-5 grid gap-3">{[['Is mobile measurement the same as product analytics?','No. Product analytics focuses on behavior inside the app. MMP-based mobile measurement focuses on campaign attribution and partner measurement for installs and downstream outcomes.'],['Does an MMP attribute every install?','No. Attribution depends on platform signals, privacy choices, partner rules, lookback settings and available data. Aggregated privacy-preserving measurement may apply.'],['Can you configure deep linking?','We can configure and validate direct or deferred deep-link journeys where supported by the chosen platform, app and routing setup.'],['Can MMP revenue match backend revenue exactly?','The backend or store is generally the operational source of truth for transactions. We define event and reconciliation rules and document expected differences across destinations.']].map(([q,a])=><details class="rounded-lg border bg-card p-4"><summary class="cursor-pointer font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">{q}</summary><p class="mt-3 text-sm leading-6 text-muted-foreground">{a}</p></details>)}</div></div></section>
  <ServiceCTA title="Make app attribution measurable and testable." detail="Define the journeys, partner mappings and privacy expectations before configuring SDKs and postbacks." primaryLabel="Plan My Mobile Measurement" />
</BaseLayout>
