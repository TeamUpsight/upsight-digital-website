---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import ServerSideArchitecture from '../../components/services/ServerSideArchitecture.astro';
import ServiceProofCard from '../../components/services/ServiceProofCard.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import { serviceSchema } from '../../lib/seo';
---
<BaseLayout title="Server-Side Tracking & sGTM Implementation | Upsight Digital" description="Design and implement server-side tracking with Google Tag Manager Server-Side, first-party collection paths, consent-aware routing, conversion APIs, deduplication, and technical QA." jsonLd={serviceSchema('Server-Side Tracking & sGTM Implementation', 'Server-side tracking architecture, GTM Server-Side, consent-aware routing, destination integrations, deduplication, and QA.', '/services/server-side-tracking/')}>
  <ServiceHero eyebrow="SERVER-SIDE MEASUREMENT" title="Server-Side Tracking & sGTM Implementation" lead="Move measurement beyond a browser-only setup." detail="Upsight designs the event path from websites, mobile apps, and backend systems into a controlled server-side layer, then routes validated data to analytics and advertising platforms." primaryLabel="Discuss Your Tracking Architecture"><div slot="visual" class="font-mono text-sm leading-7"><p class="service-kicker">ARCHITECTURE PREVIEW</p><p class="mt-3">Website / App / Backend</p><p class="text-primary">↓</p><p>metrics.yourdomain.com</p><p class="text-primary">↓</p><p class="rounded border border-primary/40 bg-primary/10 p-3">GTM Server-Side<br /><span class="text-xs text-muted-foreground">routing · QA · destinations</span></p></div></ServiceHero>
  <div id="service-detail" class="container py-10 md:py-16"><ServerSideArchitecture /></div>
  <section class="py-12 md:py-16"><div class="container grid gap-8 lg:grid-cols-2"><div><p class="service-kicker">WHY THIS EXISTS</p><h2 class="service-heading mt-3">Why Browser-Only Measurement Becomes Hard to Control</h2></div><p class="leading-7 text-muted-foreground">Browser privacy controls, ad blockers, direct vendor scripts, fragmented event mapping, consent propagation, and duplicate browser/server events can make an event path difficult to govern. Server-side routing centralizes selected processing and delivery; it does not bypass consent or make every destination identical.</p></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">ENGINEERING SCOPE</p><h2 class="service-heading mt-3">What Upsight Actually Builds</h2><div class="mt-6 grid gap-4 md:grid-cols-3">{[['Measurement architecture','Source mapping, first-party collection path, browser/server responsibility, event ownership.'],['Server container','sGTM clients, tags, variables, transformations, and routing.'],['Platform delivery','GA4, Google Ads, Meta CAPI, TikTok, Snapchat, and agreed APIs.'],['Quality controls','event_id strategy, deduplication, consent propagation, payload validation.'],['Infrastructure','Tagging domain, hosting, permissions, environments, documentation, handover.']].map(([title,detail]) => <article class="service-proof-card"><h3>{title}</h3><p>{detail}</p></article>)}</div></div></section>
  <section class="py-12 md:py-16"><div class="container max-w-5xl rounded-2xl border border-primary/30 bg-primary/5 p-8"><p class="service-kicker">ARCHITECTURE BEFORE TOOLING</p><h2 class="service-heading mt-3">We Don’t Start With the Server Container</h2><p class="mt-4 leading-7 text-muted-foreground">Before implementation, we map the business journey, event definition, source of truth, consent state, collection path, destinations, and validation plan.</p><p class="mt-5 font-mono text-sm text-primary">Business Journey → Event Definition → Source of Truth → Consent → Collection Path → Destinations → Validation</p></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">PROOF</p><h2 class="service-heading mt-3">Server-Side Measurement in Practice</h2><div class="mt-6 grid gap-4 md:grid-cols-2"><ServiceProofCard metric="99% order match" title="Slice" detail="Approved Slice evidence includes server-side measurement and a 99% order-match result." href="/case-studies/slice/" /><ServiceProofCard title="Roadsurfer" detail="Roadsurfer’s foundation combined GA4, GTM, ecommerce data-layer, and server-side work." href="/case-studies/roadsurfer/" /></div></div></section>
  <section class="py-12 md:py-16"><div class="container max-w-4xl"><h2 class="service-heading">Technical questions</h2><div class="mt-5 space-y-3">{[['Does server-side tracking replace browser tracking?','Often both paths coexist; the split depends on destination capabilities, consent state, and event design.'],['Does sGTM bypass consent?','No. Consent rules and destination requirements still apply.'],['How do you prevent duplicate conversions?','We define a stable event_id strategy and validate deduplication for agreed journeys.']].map(([q,a]) => <details class="rounded border border-border p-4"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-3 text-sm text-muted-foreground">{a}</p></details>)}</div><p class="mt-6 text-sm">Related: <a class="text-primary underline" href="/services/meta-conversions-api/">Meta CAPI</a>, <a class="text-primary underline" href="/services/ga4-gtm-setup/">GA4 &amp; GTM</a>, <a class="text-primary underline" href="/services/tracking-audit/">Tracking Audit</a>.</p></div></section>
  <ServiceCTA title="Design the event path before implementation starts." detail="Bring us the systems, destinations, and measurement questions you need to connect." primaryLabel="Discuss Your Tracking Architecture" secondaryLabel="Review My Current Setup" />
</BaseLayout>
