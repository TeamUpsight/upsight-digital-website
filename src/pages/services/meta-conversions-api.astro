---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import MetaCapiFlow from '../../components/services/MetaCapiFlow.astro';
import ServiceProofCard from '../../components/services/ServiceProofCard.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import { serviceSchema } from '../../lib/seo';
const implementation = [['Event architecture','Standard and custom event mapping, business conversion definitions, ownership, and browser/server responsibility.'],['Pixel + CAPI','Meta Pixel review, CAPI delivery, coexistence design, and a stable event_id strategy.'],['Matching data','Available customer data, hashing requirements, browser identifiers, and source-system mapping.'],['Consent','CMP signals, marketing consent, data-routing decisions, and requirements supplied by privacy stakeholders.'],['QA','Test Events, Events Manager diagnostics, browser/server requests, IDs, and payload comparison.']];
const faqs = [['Does CAPI replace the Meta Pixel?','Usually no. Browser and server paths can coexist when they describe the same agreed business action consistently.'],['Do I need server-side GTM to use CAPI?','Not always. It is one implementation route; the right architecture depends on the stack and ownership model.'],['What is event_id used for?','It gives browser and server representations of the same action a stable identity for the intended deduplication design.'],['Why can browser and server events create duplicates?','If event names, IDs, timing, or payload context diverge, the two paths may not be paired as intended.'],['What customer data can be sent to Meta?','Only eligible data appropriate to the available consent, source system, and implementation should be considered.'],['Does CAPI bypass cookie consent?','No. Consent and platform requirements still determine whether and how delivery occurs.'],['How do you validate the implementation?','We review representative browser and server requests alongside Meta diagnostics for the agreed conversion journeys.']];
---
<BaseLayout title="Meta Conversions API (CAPI) Implementation | Upsight Digital" description="Implement Meta Conversions API with browser/server event mapping, event IDs, deduplication, consent-aware delivery, matching data, diagnostics, and technical QA." jsonLd={serviceSchema('Meta Conversions API Implementation', 'Meta Conversions API implementation including browser/server event mapping, event IDs, deduplication, consent-aware delivery, matching data, diagnostics, and QA.', '/services/meta-conversions-api/')}>
  <ServiceHero eyebrow="META MEASUREMENT" title="Meta Conversions API Implementation" lead="Connect browser and server conversion events without creating duplicates, mismatched payloads, or unexplained reporting gaps." detail="Upsight maps the full conversion path from your website or backend into Meta Pixel and Conversions API, aligns browser and server payloads, configures event IDs and matching data, and validates the implementation in Meta's diagnostics." primaryLabel="Review My Meta Tracking"><div slot="visual" class="font-mono text-sm leading-7"><p class="service-kicker">DELIVERY PREVIEW</p><p class="mt-3">Browser Pixel <span class="text-primary">↘</span></p><p>Server CAPI <span class="text-primary">↗</span> META</p><p class="mt-3">event: Purchase<br />event_id: ORD-8472</p><p class="mt-3 rounded border border-primary/40 bg-primary/10 p-3">1 conversion<br /><span class="text-xs">Deduplicated</span></p></div></ServiceHero>
  <div class="container py-10 md:py-16"><MetaCapiFlow /></div>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container grid gap-8 lg:grid-cols-[.8fr_1.2fr]"><div><p class="service-kicker">COORDINATED DELIVERY</p><h2 class="service-heading mt-3">CAPI Is Not Just a Second Copy of the Pixel</h2></div><div><p class="leading-7 text-muted-foreground">When browser and server delivery coexist, they need to describe the same customer action consistently. That means aligning the event name, business action, event ID, timing, parameters, consent state, and source data.</p><p class="mt-4 leading-7 text-muted-foreground">Most CAPI problems are coordination problems across the website, data layer, backend, server-side layer, and Meta configuration.</p><p class="service-flow-line mt-6">Business Action ↓ Browser Event ↓ Shared Event Identity ↓ Server Event ↓ Meta ↓ Diagnostics</p></div></div></section>
  <section class="py-12 md:py-16"><div class="container"><p class="service-kicker">IMPLEMENTATION SCOPE</p><h2 class="service-heading mt-3">What Upsight Implements</h2><div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{implementation.map(([title, detail]) => <article class="service-proof-card"><h3>{title}</h3><p>{detail}</p></article>)}</div></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">IMPLEMENTATION WORKFLOW</p><h2 class="service-heading mt-3">From conversion definition to Meta validation</h2><ol class="mt-6 grid gap-3 md:grid-cols-2 lg:grid-cols-3">{[['01','Define conversion','Agree the business action and its source of truth.'],['02','Trace source data','Identify browser, backend, and consent inputs.'],['03','Design the pair','Align event name, timing, IDs, and responsibility.'],['04','Implement','Configure the agreed browser and server delivery.'],['05','Deduplicate','Exercise the paired paths with stable event identity.'],['06','Validate in Meta','Review requests, Test Events, and diagnostics.']].map(([n,title,detail]) => <li class="service-proof-card"><p class="font-mono text-primary">{n}</p><h3 class="mt-2">{title}</h3><p>{detail}</p></li>)}</ol></div></section>
  <section class="py-12 md:py-16"><div class="container grid gap-5 md:grid-cols-2"><ServiceProofCard metric="99% order match" title="Slice" detail="Approved Slice evidence includes server-side measurement and a 99% order-match result." href="/case-studies/slice/" /><div class="service-proof-card"><p class="service-kicker">RELATED PATH</p><h2 class="mt-2 text-xl font-semibold">CAPI can be part of a wider server-side architecture</h2><p class="mt-3 text-sm leading-6 text-muted-foreground">See how an agreed event path can be routed and governed across destinations.</p><a class="mt-5 inline-flex font-semibold text-primary underline underline-offset-4" href="/services/server-side-tracking/">Explore Server-Side Tracking →</a></div></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container max-w-4xl"><h2 class="service-heading">Technical questions</h2><div class="mt-5 space-y-3">{faqs.map(([q,a]) => <details class="rounded border border-border p-4"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-3 text-sm leading-6 text-muted-foreground">{a}</p></details>)}</div><p class="mt-6 text-sm">Related: <a class="text-primary underline" href="/services/tracking-audit/">Tracking Audit</a> and <a class="text-primary underline" href="/services/ga4-gtm-setup/">GA4 &amp; GTM</a>.</p></div></section>
  <ServiceCTA title="Make Browser and Server Events Work as One Measurement System" detail="Bring the conversion journeys, source systems, and Meta diagnostics you need to make sense of." primaryLabel="Review My Meta Tracking" secondaryLabel="Explore Server-Side Tracking" secondaryHref="/services/server-side-tracking/" />
</BaseLayout>
