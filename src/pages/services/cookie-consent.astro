---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import ConsentRoutingSimulator from '../../components/services/ConsentRoutingSimulator.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import { serviceSchema } from '../../lib/seo';
const groups = [['CMP setup','Platform configuration, domain setup, banner configuration, categories, languages, and approved regional rules.'],['Google Consent Mode','Default consent state, consent updates, analytics_storage, ad_storage, ad_user_data, and ad_personalization.'],['GTM routing','Built-in and additional consent checks, vendor firing rules, and consent initialization.'],['Marketing platforms','Google, Meta, TikTok, Snapchat, and other agreed vendors.'],['Validation','Accept, reject, partial consent, returning visitor, consent update, network/tag behaviour, and GTM consent state.']];
const faqs = [['Is a cookie banner enough?','No. A CMP collects a choice; the measurement implementation must translate it into technical behaviour across tags and platforms.'],['What is Google Consent Mode?','It is a Google framework for communicating consent states to Google tags. Its technical behaviour depends on its implementation and configuration.'],['What do ad_user_data and ad_personalization control?','They are consent signals used in Google’s Consent Mode framework for specific advertising-related processing decisions.'],['Can GTM block tags until consent?','Yes, GTM consent checks and configured firing rules can govern tags in the agreed consent model.'],['Can the setup vary by country or region?','Technical rules can be configured where the approved consent model calls for them.'],['Does Consent Mode replace a CMP?','No. Consent Mode does not replace the CMP interface and policy decisions that collect and define user consent.'],['Do you work with Cookiebot?','Yes. Upsight has a visible Usercentrics Cookiebot Certified Partner proof strip on this page.'],['Do you write our privacy policy?','Upsight can support the technical vendor inventory; privacy-policy language should be approved by qualified legal/privacy stakeholders.'],['How do you test whether tags fire before consent?','We test defined consent scenarios through browser/network behaviour and GTM consent state against the approved model.']];
---
<BaseLayout title="Cookie Consent & CMP Implementation | Upsight Digital" description="Implement Cookie Consent, Google Consent Mode, GTM consent checks, and consent-aware routing for analytics and marketing tags." jsonLd={serviceSchema('Cookie Consent & CMP Implementation', 'Technical CMP implementation including Google Consent Mode, GTM consent checks, and consent-aware analytics and marketing tag routing.', '/services/cookie-consent/')}>
  <ServiceHero eyebrow="CONSENT-AWARE MEASUREMENT" title="Cookie Consent & CMP Implementation" lead="Make user consent choices control the tracking behind your website." detail="Upsight implements the CMP, consent states, Google Consent Mode, GTM controls and vendor routing needed to make tracking respond consistently to user choices." primaryLabel="Review My Consent Setup"><div slot="visual" class="font-mono text-sm leading-6"><p class="service-kicker">ILLUSTRATIVE CONSENT STATE</p><p class="mt-3">USER CHOICE<br /><strong>Analytics only</strong></p><p class="mt-3">analytics_storage <span class="text-primary">granted</span><br />ad_storage <span class="text-destructive">denied</span><br />ad_user_data <span class="text-destructive">denied</span><br />ad_personalization <span class="text-destructive">denied</span></p><p class="mt-3 rounded border border-primary/40 bg-primary/10 p-2">GA4 consent-aware<br />Meta blocked<br />TikTok blocked</p></div></ServiceHero>
  <section class="border-y border-border bg-muted/20 py-7"><div class="container grid grid-cols-2 items-center gap-5 text-center md:grid-cols-5"><div class="flex justify-center"><img src="https://d2xsxph8kpxj0f.cloudfront.net/310519663269151870/NKnKdFDxhaRVudBQKnGMGB/cookiebot-certified-partner_f709749f.png" alt="Cookiebot by Usercentrics - Certified Partner" class="h-16 w-auto object-contain md:h-20" width="120" height="80" /></div>{[['Top 50','Reseller in North America'],['165+','Brands Secured'],['8.8M+','Monthly Consents'],['10+','Languages Localized']].map(([value,label]) => <div><strong class="block text-lg text-primary md:text-xl">{value}</strong><span class="mt-1 block text-xs text-muted-foreground">{label}</span></div>)}</div></section>
  <div class="container py-10 md:py-16"><ConsentRoutingSimulator /></div>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container grid gap-8 lg:grid-cols-[.8fr_1.2fr]"><div><p class="service-kicker">MEASUREMENT BEHAVIOUR</p><h2 class="service-heading mt-3">The Banner Is Only the Front End</h2></div><div><p class="leading-7 text-muted-foreground">A CMP collects and communicates the user’s choice. The measurement implementation then needs to translate that choice into technical behaviour across tags and platforms.</p><p class="service-flow-line mt-6">Consent Banner ↓ Consent State ↓ Google Consent Mode ↓ GTM Consent Checks ↓ Vendor Routing ↓ Analytics / Advertising Platforms</p></div></div></section>
  <section class="py-12 md:py-16"><div class="container"><p class="service-kicker">IMPLEMENTATION SCOPE</p><h2 class="service-heading mt-3">What Upsight Implements</h2><div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{groups.map(([title,detail]) => <article class="service-proof-card"><h3>{title}</h3><p>{detail}</p></article>)}</div></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container max-w-5xl"><p class="service-kicker">CONSENT QA</p><h2 class="service-heading mt-3">How We Validate Consent</h2><div class="mt-6 overflow-x-auto rounded-xl border border-border"><table class="w-full text-left text-sm"><caption class="caption-bottom p-3 text-left text-xs text-muted-foreground">Illustrative technical test matrix. Actual expected behaviour is defined by the approved consent model.</caption><thead class="bg-card"><tr><th scope="col" class="p-3">Scenario</th><th scope="col" class="p-3">GA4</th><th scope="col" class="p-3">Google Ads</th><th scope="col" class="p-3">Meta</th><th scope="col" class="p-3">TikTok</th></tr></thead><tbody class="text-muted-foreground"><tr><th scope="row" class="p-3 text-foreground">Accept all</th><td class="p-3">✓</td><td class="p-3">✓</td><td class="p-3">✓</td><td class="p-3">✓</td></tr><tr><th scope="row" class="p-3 text-foreground">Analytics only</th><td class="p-3">✓</td><td class="p-3">restricted</td><td class="p-3">blocked</td><td class="p-3">blocked</td></tr><tr><th scope="row" class="p-3 text-foreground">Reject</th><td class="p-3">restricted</td><td class="p-3">restricted</td><td class="p-3">blocked</td><td class="p-3">blocked</td></tr></tbody></table></div></div></section>
  <section class="py-12 md:py-16"><div class="container grid gap-6 lg:grid-cols-2"><div><p class="service-kicker">TECHNICAL, NOT LEGAL ADVICE</p><h2 class="service-heading mt-3">Technical Implementation Needs an Approved Consent Model</h2><p class="mt-4 leading-7 text-muted-foreground">Upsight can implement and validate the technical behaviour of the CMP, Consent Mode and tag-routing configuration.</p><p class="mt-4 leading-7 text-muted-foreground">The client’s legal/privacy stakeholders remain responsible for determining the appropriate legal basis, policy language, jurisdictions, retention requirements and consent model.</p></div><div class="grid grid-cols-2 gap-3">{['Usercentrics Cookiebot','Google Consent Mode','Google Tag Manager','Google Analytics 4','Meta','TikTok','Snapchat','Shopify','WordPress / WooCommerce','Custom websites'].map(tool => <div class="rounded-xl border border-border bg-muted/20 p-3 text-center text-sm font-semibold">{tool}</div>)}</div></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container max-w-4xl"><h2 class="service-heading">Cookie consent questions</h2><div class="mt-5 space-y-3">{faqs.map(([q,a]) => <details class="rounded border border-border p-4"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-3 text-sm leading-6 text-muted-foreground">{a}</p></details>)}</div><p class="mt-6 text-sm">Related: <a class="text-primary underline" href="/services/server-side-tracking/">Server-Side Tracking</a>, <a class="text-primary underline" href="/services/ga4-gtm-setup/">GA4 &amp; GTM</a>, <a class="text-primary underline" href="/services/meta-conversions-api/">Meta CAPI</a>, and <a class="text-primary underline" href="/services/tracking-audit/">Tracking Audit</a>.</p></div></section>
  <ServiceCTA title="Make Consent Choices Control the Tracking Behind the Banner" detail="Bring the current CMP, tag setup, intended regions, and approved consent model into a focused implementation review." primaryLabel="Review My Consent Setup" secondaryLabel="Discuss the Implementation" secondaryHref="/contact/" />
</BaseLayout>
