---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import ConsentRoutingSimulator from '../../components/services/ConsentRoutingSimulator.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import { serviceSchema } from '../../lib/seo';

const capabilities = [
  ['CMP configuration', 'Configure an existing CMP, implement a platform or support a migration.'],
  ['Regional consent rules', 'Apply the organisation’s approved defaults and technical rules across relevant markets.'],
  ['Technology classification', 'Map cookies, pixels, scripts and storage technologies to approved purposes and categories.'],
  ['Google Consent Mode', 'Configure default states, updates and analytics_storage, ad_storage, ad_user_data and ad_personalization.'],
  ['GTM consent controls', 'Map tags to built-in or additional consent checks and agreed firing conditions.'],
  ['GPC & universal opt-outs', 'Where applicable, detect browser privacy signals and apply them to corresponding controls.'],
  ['IAB TCF', 'Where applicable, configure and validate vendor disclosures, choices and consent signalling.'],
  ['Records & preference changes', 'Validate preference persistence and the ability to revisit, change or withdraw choices.'],
];

const qa = [
  ['Before any choice', 'Check whether technologies that should be restricted start before the expected choice or state is established.'],
  ['Accept all', 'Verify permitted measurement and advertising integrations activate as configured.'],
  ['Reject or opt out', 'Check restricted technologies stop or change behaviour according to the approved implementation.'],
  ['Partial consent', 'Verify categories and purposes behave independently.'],
  ['GPC / browser privacy signals', 'For applicable US configurations, confirm recognized signals change the appropriate downstream behaviour.'],
  ['Preference changes / withdrawal', 'Confirm an updated or withdrawn preference reaches the technical state and downstream tracking.'],
];

const workSteps = [
  ['01', 'Audit', 'Inspect the CMP, cookies and storage, tags, network requests, Consent Mode, GTM state, GPC where relevant and pre-choice behaviour.'],
  ['02', 'Map requirements', 'Translate markets, vendors, purposes, approved privacy rules and stakeholder requirements into a technical consent model.'],
  ['03', 'Configure', 'Set up the CMP, regional rules, Consent Mode, GTM controls, vendor routing, GPC handling and TCF where applicable.'],
  ['04', 'Validate', 'Test before choice, accept, reject, partial consent, GPC, preference updates and return visits.'],
  ['05', 'Document', 'Record the technical implementation for marketing, development, analytics and privacy stakeholders.'],
];

const cmpExamples = ['OneTrust', 'Usercentrics Cookiebot', 'Didomi', 'Sourcepoint', 'TrustArc', 'consentmanager', 'CookieYes', 'Osano', 'Google-certified CMPs', 'Shopify consent solutions', 'WordPress CMPs', 'Custom implementations'];
const measurementPlatforms = ['Google Analytics 4', 'Google Tag Manager', 'Google Ads', 'Meta', 'TikTok', 'Snapchat', 'LinkedIn', 'Server-Side GTM'];
const glossary = [
  ['CMP', 'A Consent Management Platform presents privacy choices and stores or communicates visitor preferences.'],
  ['Prior consent', 'A model where certain technologies should not begin the relevant activity before the required choice is received.'],
  ['Opt-out', 'A privacy model where processing may operate until a person exercises a right to stop specified uses.'],
  ['GPC', 'A browser or device signal used to communicate certain privacy opt-out preferences automatically.'],
  ['Consent Mode', 'Google’s framework for communicating consent states to supported Google services and changing their technical behaviour.'],
  ['TCF', 'An industry framework used in parts of advertising to standardize disclosures and communicate choices between publishers, CMPs and vendors.'],
  ['Consent leakage', 'A technical term for activity by a tag, cookie, pixel or other technology that conflicts with the intended consent or privacy state.'],
  ['Dark patterns', 'Interface designs that impair or interfere with genuine privacy choice. Consent interfaces should offer clear, balanced choices.'],
];
const audiences = [
  ['Ecommerce brands', 'Consent-aware analytics and advertising across relevant markets.'],
  ['Marketing & paid media teams', 'Understand what happens to measurement as privacy states change.'],
  ['Marketing agencies', 'Implement maintainable CMP and tracking configurations for clients.'],
  ['Multi-region businesses', 'Support different regional models through one governed architecture.'],
  ['Privacy & technology teams', 'Translate approved privacy requirements into technical controls.'],
];
const faqs = [
  ['Do I need a cookie banner on every website?', 'Not necessarily. Requirements depend on applicable jurisdictions, technologies and purposes, and how information or personal data is processed. EU, UK and US privacy models differ. Upsight implements the technical model defined for your organisation rather than applying one global banner configuration.'],
  ['Can Upsight work with our existing CMP?', 'Yes. Upsight is CMP-independent and works with established commercial platforms, platform-native solutions and custom implementations. Replacement is generally considered when a platform cannot support the required technical model.'],
  ['Can you recommend which CMP we should use?', 'We can compare options from a technical and operational perspective: markets, web and app requirements, advertising stack, integrations, languages, domains, TCF needs, GPC and regional capabilities, and your team’s operating model. This is not a legal recommendation.'],
  ['We already have a cookie banner. Why would we need an audit?', 'A visible banner does not prove downstream technologies follow it. An audit can find pre-choice tag activity, rejected marketing pixels, incorrect Consent Mode states, broken partial choices, preference updates that do not propagate or ignored GPC signals.'],
  ['Can you fix tracking without replacing the CMP?', 'Often. The issue is frequently the integration between the CMP, website, GTM, Consent Mode, vendor tags and server-side setup rather than the CMP product itself.'],
  ['Can one CMP support EU, UK and US users?', 'Many major CMPs support regional configuration, but the implementation must reflect the different approved privacy models for each market.'],
  ['Can you implement Global Privacy Control?', 'Where relevant, yes. Upsight can implement and test the technical handling of GPC and its effect on applicable downstream controls.'],
  ['Does Google Consent Mode replace a CMP?', 'No. A CMP captures and manages the visitor’s privacy choice. Consent Mode communicates relevant states to supported Google technologies. They have different roles.'],
  ['Will implementing consent reduce our analytics data?', 'Privacy choices can reduce directly observable data, and our objective is not to bypass them. Our goal is to collect the cleanest measurement your approved privacy model permits, while avoiding unnecessary data loss caused by incorrect implementation.'],
  ['Does server-side tracking bypass consent?', 'No. Relevant consent and opt-out states should continue to control processing and routing where applicable. See our <a href="/services/server-side-tracking/" class="text-primary underline">server-side tracking implementation</a>.'],
  ['Can you guarantee legal compliance?', 'No. Upsight provides technical consent implementation, auditing and measurement expertise, not legal advice. Your legal or privacy stakeholders determine the requirements that apply; we translate those requirements into technical controls and validate their behaviour.'],
];

const title = 'Cookie Consent & CMP Implementation | GDPR, CCPA & PECR | Upsight Digital';
const description = 'CMP implementation and consent audits for GDPR, ePrivacy, UK GDPR, PECR, CCPA/CPRA, GPC and Google Consent Mode. Configure, integrate and validate consent across your analytics and advertising stack.';
---

<BaseLayout title={title} description={description} jsonLd={serviceSchema('Cookie Consent & CMP Implementation', 'Technical consent implementation, CMP configuration and validation across analytics and advertising technologies.', '/services/cookie-consent/')}>
  <ServiceHero eyebrow="CONSENT & PRIVACY IMPLEMENTATION" title="Cookie Consent & CMP Implementation" lead="Build consent and privacy controls that actually work behind the banner." detail="We implement, configure and audit Consent Management Platforms, regional privacy controls, Google Consent Mode and consent-aware tracking across your analytics and advertising stack. Whether you already use a CMP or need help evaluating one, we make sure user choices are correctly captured, communicated and respected by the technologies running on your website." primaryLabel="Review My Consent Setup">
    <div slot="visual" class="font-mono text-sm leading-6"><p class="service-kicker">ILLUSTRATIVE TECHNICAL CONFIGURATION</p><p class="mt-3">VISITOR CHOICE<br /><strong>Analytics only</strong></p><p class="mt-3">CONSENT STATE<br />analytics_storage <span class="text-primary">granted</span><br />ad_storage <span class="text-destructive">denied</span><br />ad_user_data <span class="text-destructive">denied</span><br />ad_personalization <span class="text-destructive">denied</span></p><p class="mt-3">TECHNICAL ROUTING<br />GA4 consent-restricted<br />Google Ads restricted<br />Meta / TikTok blocked by configured marketing rule</p></div>
  </ServiceHero>
  <div class="container -mt-5 pb-7"><p class="text-center font-mono text-[.68rem] leading-6 text-muted-foreground">CMP configuration · GDPR / ePrivacy · UK GDPR / PECR · CCPA / CPRA · GPC · Consent Mode · IAB TCF · GTM consent routing</p></div>

  <section class="border-y border-border bg-muted/20 py-7" aria-label="Cookiebot partner credentials"><div class="container grid grid-cols-2 items-center gap-5 text-center md:grid-cols-5"><div class="flex justify-center"><img src="https://d2xsxph8kpxj0f.cloudfront.net/310519663269151870/NKnKdFDxhaRVudBQKnGMGB/cookiebot-certified-partner_f709749f.png" alt="Cookiebot by Usercentrics - Certified Partner" class="h-16 w-auto object-contain md:h-20" width="120" height="80" /></div>{[['Top 50','Reseller in North America'],['165+','Brands Secured'],['8.8M+','Monthly Consents'],['10+','Languages Localized']].map(([value,label]) => <div><strong class="block text-lg text-primary md:text-xl">{value}</strong><span class="mt-1 block text-xs text-muted-foreground">{label}</span></div>)}</div></section>

  <section class="py-10 md:py-14"><div class="container grid items-start gap-5 lg:grid-cols-[.7fr_1.3fr]"><div><p class="service-kicker">CMP-INDEPENDENT SUPPORT</p><h2 class="service-heading mt-3">A Cookie Banner Is Only the Front End</h2></div><div><p class="leading-7 text-muted-foreground">The banner is only the front end. The real implementation is everything that happens after the visitor makes a choice. A banner can look correct while tracking behaves differently behind it: tags may operate before the expected choice, rejected categories may continue sending data, privacy signals may be ignored, or preferences may not reach GTM and downstream platforms.</p><div class="mt-6 grid gap-3 md:grid-cols-3"><article class="service-proof-card"><h3 class="font-semibold">Privacy control gaps</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">Technologies may operate outside the privacy choices your organisation intended to enforce.</p></article><article class="service-proof-card"><h3 class="font-semibold">Unreliable measurement</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">Incorrect setup can unnecessarily suppress permitted measurement or allow activity that should be restricted.</p></article><article class="service-proof-card"><h3 class="font-semibold">Regional complexity</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">EU, UK and US privacy models differ, so one global configuration can create technical and governance problems.</p></article></div><p class="mt-5 text-sm leading-6 text-muted-foreground">Cookiebot is an approved partner relationship and proof point. We also work with other CMPs and custom consent setups.</p></div></div></section>

  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">REGIONAL PRIVACY REQUIREMENTS</p><h2 class="service-heading mt-3">Privacy Rules Work Differently by Region</h2><p class="mt-4 max-w-3xl leading-7 text-muted-foreground">Privacy requirements vary by region, purpose and technology. We help translate your organisation’s approved privacy requirements into a technical consent configuration.</p><div class="mt-7 grid gap-4 lg:grid-cols-3">
    <article class="service-proof-card"><h3 class="text-xl font-semibold">EU / EEA</h3><h4 class="mt-5 font-semibold">GDPR</h4><p class="mt-2 text-sm leading-6 text-muted-foreground">Personal-data processing needs an appropriate legal basis. Where consent is used, it must be freely given, specific, informed and unambiguous, and it must be possible to withdraw it.</p><h4 class="mt-4 font-semibold">ePrivacy</h4><p class="mt-2 text-sm leading-6 text-muted-foreground">GDPR governs personal-data processing, while ePrivacy rules are particularly relevant to storing or accessing information on a device. Non-exempt tracking commonly requires prior consent, subject to applicable national rules.</p><h4 class="mt-4 font-semibold">IAB TCF & Google Consent Mode</h4><p class="mt-2 text-sm leading-6 text-muted-foreground">Where applicable, TCF communicates transparency, vendor information and choices. Google Consent Mode communicates relevant states to supported Google services. Neither determines the organisation’s legal model.</p></article>
    <article class="service-proof-card"><h3 class="text-xl font-semibold">United Kingdom</h3><h4 class="mt-5 font-semibold">UK GDPR & PECR</h4><p class="mt-2 text-sm leading-6 text-muted-foreground">UK GDPR applies to personal-data processing. PECR covers cookies and other storage and access technologies, including pixels, scripts, web storage and fingerprinting.</p><h4 class="mt-4 font-semibold">Purpose-specific exceptions</h4><p class="mt-2 text-sm leading-6 text-muted-foreground">Following changes introduced through the Data (Use and Access) Act 2025, PECR includes additional purpose-specific exceptions, including qualifying statistical measurement and appearance/functionality uses. The statistical exception is narrow: its sole purpose must be statistics about service use to improve it, not individual tracking, profiling or advertising measurement; people need clear information and a simple, free way to object. These conditions do not create a blanket analytics exemption. Personal-data processing must still comply with UK GDPR where applicable.</p></article>
    <article class="service-proof-card"><h3 class="text-xl font-semibold">United States</h3><p class="mt-4 text-sm leading-6 text-muted-foreground">The US primarily uses state privacy regimes rather than one nationwide GDPR-style cookie-consent model.</p><h4 class="mt-4 font-semibold">Sale / sharing & targeted advertising</h4><p class="mt-2 text-sm leading-6 text-muted-foreground">Applicable laws may give consumers opt-out rights for particular disclosures or targeted advertising, and choices about sensitive data where applicable.</p><h4 class="mt-4 font-semibold">GPC / universal opt-out signals</h4><p class="mt-2 text-sm leading-6 text-muted-foreground">Global Privacy Control and other qualifying universal opt-out mechanisms can communicate applicable choices. For covered businesses, CCPA as amended by CPRA may require honoring sale/sharing opt-outs; GPC is a valid request where that requirement applies. Colorado currently recognizes GPC as its UOOM for applicable sale and targeted-advertising opt-outs.</p></article>
  </div><p class="mt-4 text-xs leading-5 text-muted-foreground">This is a technical overview, not a complete legal summary. Applicable rules depend on your organisation, activities and locations.</p></div></section>

  <section class="py-12 md:py-16"><div class="container"><p class="service-kicker">CONSENT ARCHITECTURE</p><h2 class="service-heading mt-3">One Consent Layer Across Your Marketing Stack</h2><p class="mt-4 max-w-3xl leading-7 text-muted-foreground">A CMP captures and manages the visitor’s privacy choice. Consent Mode communicates relevant consent states to supported Google technologies. These are different roles in a wider consent layer.</p><div class="mt-7 grid gap-3 text-center text-sm sm:grid-cols-[1fr_auto_1fr_auto_1.5fr_auto_2fr] sm:items-center"><div class="rounded-xl border border-border bg-muted/20 p-4 font-semibold">Visitor</div><span aria-hidden="true" class="text-primary sm:-rotate-90">↓</span><div class="rounded-xl border border-primary/40 bg-primary/10 p-4 font-semibold">CMP</div><span aria-hidden="true" class="text-primary sm:-rotate-90">↓</span><div class="rounded-xl border border-border bg-muted/20 p-4 font-semibold">Consent / privacy state<br /><small class="font-normal text-muted-foreground">GPC · TCF where applicable</small></div><span aria-hidden="true" class="text-primary sm:-rotate-90">↓</span><div class="rounded-xl border border-border bg-muted/20 p-4">Google Consent Mode<br />GTM consent controls<br />Vendor & server-side routing</div></div><div class="mt-3 rounded-xl border border-border bg-card/60 p-4 text-center text-sm text-muted-foreground">GA4 · Google Ads · Meta · TikTok · Snapchat · LinkedIn · Server-Side Tracking · other approved vendors</div>
    <div class="mt-10"><h3 class="text-xl font-semibold">Technical consent capabilities</h3><div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{capabilities.map(([name, detail]) => <article class="service-proof-card"><h4 class="font-semibold">{name}</h4><p class="mt-2 text-sm leading-6 text-muted-foreground">{detail}</p></article>)}</div></div>
  </div></section>

  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">INTERACTIVE EXAMPLE</p><h2 class="service-heading mt-3">See How a Choice Reaches the Measurement System</h2><p class="mt-3 max-w-3xl text-sm leading-6 text-muted-foreground">The simulator demonstrates technical behaviour; it is not a legal-decision engine. Its example configuration is not the right model for every organisation.</p><div class="mt-7"><ConsentRoutingSimulator /></div></div></section>

  <section class="py-12 md:py-16"><div class="container max-w-5xl"><p class="service-kicker">GOOGLE CONSENT MODE</p><h2 class="service-heading mt-3">Basic vs Advanced Google Consent Mode</h2><p class="mt-4 max-w-3xl leading-7 text-muted-foreground">Google Consent Mode changes the behaviour of supported Google technologies based on consent states. It does not collect or manage the visitor’s choice; that is the CMP’s role.</p><div class="mt-6 grid gap-4 md:grid-cols-2"><article class="service-proof-card"><h3 class="text-lg font-semibold">Basic</h3><p class="mt-3 text-sm leading-6 text-muted-foreground">Google tags requiring consent are prevented from loading until the required consent state is granted.</p></article><article class="service-proof-card"><h3 class="text-lg font-semibold">Advanced</h3><p class="mt-3 text-sm leading-6 text-muted-foreground">Supported Google tags can load with default consent states and alter collection behaviour according to the choice. When storage is denied, limited or cookieless measurement may still be sent for supported measurement and modelling use cases.</p></article></div><p class="mt-4 text-sm text-muted-foreground">The appropriate consent model must be defined by the organisation’s privacy/legal stakeholders. Advanced Mode is not automatically appropriate for every organisation.</p></div></section>

  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">CONSENT QA</p><h2 class="service-heading mt-3">We Test What Actually Happens After Every Choice</h2><p class="mt-4 text-muted-foreground">A consent implementation is not complete because the banner appears.</p><div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{qa.map(([title, detail]) => <article class="service-proof-card"><h3 class="font-semibold">{title}</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">{detail}</p></article>)}</div><div class="mt-8"><h3 class="text-xl font-semibold">Illustrative routing checks</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">Expected behaviour is defined by the approved consent model and implementation mode. Advanced Consent Mode may send limited/cookieless measurement; Basic Mode can block tags pending consent.</p><div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"><article class="service-proof-card"><h4 class="font-semibold">Accept all</h4><p class="mt-2 text-sm text-muted-foreground">Google: full measurement<br />Meta / TikTok: allowed by configured rule</p></article><article class="service-proof-card"><h4 class="font-semibold">Analytics only</h4><p class="mt-2 text-sm text-muted-foreground">GA4: consent-restricted or limited<br />Ads / marketing: restricted by rule</p></article><article class="service-proof-card"><h4 class="font-semibold">Reject</h4><p class="mt-2 text-sm text-muted-foreground">Google: consent-restricted, limited or blocked in Basic mode<br />Marketing: blocked by configured rule</p></article><article class="service-proof-card"><h4 class="font-semibold">GPC example</h4><p class="mt-2 text-sm text-muted-foreground">Applicable sale/sharing and targeted-advertising routes restricted</p></article></div><p class="mt-3 text-xs leading-5 text-muted-foreground">Illustrative technical test matrix. These states are not universal legal truth and do not define a legal configuration.</p><p class="mt-4 text-sm text-muted-foreground">For a broader measurement review, start with the <a href="/health-check/" class="text-primary underline">Analytics Health Check</a>.</p></div></div></section>

  <section class="py-12 md:py-16"><div class="container"><p class="service-kicker">MEASUREMENT INFRASTRUCTURE</p><h2 class="service-heading mt-3">Consent Infrastructure Built for Measurement</h2><div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{[['CMP setup & migration','Implement, improve or migrate the consent platform.'],['Consent-aware analytics','Reflect the approved consent model without unnecessarily suppressing permitted measurement.'],['Advertising platforms','Coordinate controls across Google, Meta, TikTok, Snapchat, LinkedIn and agreed vendors.'],['Server-side tracking','Carry relevant consent and privacy states into server-side processing rather than treating it as a bypass.'],['Vendor governance','Maintain a clearer record of technologies, purposes, owners and privacy controls.'],['Multi-domain & multi-region','Design maintainable consent architecture across brands, sites, languages and markets.']].map(([title, detail]) => <article class="service-proof-card"><h3 class="font-semibold">{title}</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">{detail}</p></article>)}</div><p class="mt-5 text-sm leading-6 text-muted-foreground">Related implementation work includes <a class="text-primary underline" href="/services/ga4-gtm-setup/">GA4 &amp; GTM setup</a>, <a class="text-primary underline" href="/services/meta-conversions-api/">Meta Conversions API</a> and <a class="text-primary underline" href="/services/tracking-audit/">tracking audits</a>.</p></div></section>

  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">DELIVERY APPROACH</p><h2 class="service-heading mt-3">How We Implement & Validate Consent</h2><div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-5">{workSteps.map(([number, title, detail]) => <article class="service-proof-card"><p class="font-mono text-primary">{number}</p><h3 class="mt-2 font-semibold">{title}</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">{detail}</p></article>)}</div></div></section>

  <section class="py-12 md:py-16"><div class="container grid gap-8 lg:grid-cols-[.8fr_1.2fr]"><div><p class="service-kicker">CMP-INDEPENDENT IMPLEMENTATION</p><h2 class="service-heading mt-3">We Work With Your CMP</h2><p class="mt-4 leading-7 text-muted-foreground">You do not need to move to a specific CMP to work with Upsight. We work with established commercial platforms, platform-native solutions and custom consent implementations. If the existing CMP can expose or communicate visitor choices in a usable way, we can usually integrate those choices into the wider analytics and advertising setup.</p><p class="mt-4 text-sm leading-6 text-muted-foreground">Examples of platforms we can work with. Support for a specific requirement depends on the platform, configuration and approved model.</p></div><div class="space-y-6"><div><h3 class="font-semibold">Consent Management Platforms</h3><ul class="mt-3 flex flex-wrap gap-2">{cmpExamples.map(name => <li class="rounded-full border border-border bg-muted/20 px-3 py-1.5 text-sm">{name}</li>)}</ul></div><div><h3 class="font-semibold">Measurement & advertising platforms</h3><ul class="mt-3 flex flex-wrap gap-2">{measurementPlatforms.map(name => <li class="rounded-full border border-border bg-muted/20 px-3 py-1.5 text-sm">{name}</li>)}</ul></div></div></div></section>

  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">PLAIN LANGUAGE</p><h2 class="service-heading mt-3">Common Consent Terms, Without the Legal Jargon</h2><div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{glossary.map(([term, detail]) => <article class="service-proof-card"><h3 class="font-semibold">{term}</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">{detail}</p></article>)}</div></div></section>

  <section class="py-12 md:py-16"><div class="container"><h2 class="service-heading">Who This Is For</h2><div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">{audiences.map(([title, detail]) => <article class="service-proof-card"><h3 class="font-semibold">{title}</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">{detail}</p></article>)}</div></div></section>

  <section class="bg-muted/30 py-12 md:py-16"><div class="container max-w-4xl"><p class="service-kicker">FREQUENTLY ASKED QUESTIONS</p><h2 class="service-heading mt-3">Cookie Consent Questions</h2><div class="mt-5 space-y-3">{faqs.map(([question, answer]) => <details class="rounded border border-border p-4"><summary class="cursor-pointer font-semibold">{question}</summary><p class="mt-3 text-sm leading-6 text-muted-foreground" set:html={answer} /></details>)}</div></div></section>

  <section class="py-12 md:py-16"><div class="container max-w-4xl"><div class="rounded-2xl border border-primary/35 bg-card/75 px-6 py-8 md:px-10"><p class="service-kicker">TECHNICAL IMPLEMENTATION, NOT LEGAL ADVICE</p><h2 class="service-heading mt-3">Technical Implementation Needs an Approved Privacy Model</h2><p class="mt-4 leading-7 text-muted-foreground">Your legal or privacy team determines which legal requirements, purposes, legal bases and regional policies apply to your organisation. Upsight translates those approved requirements into the CMP, website and measurement configuration, then validates whether the technical behaviour works as intended. Our work includes technical consent implementation, CMP configuration, consent-state integration, audits, tag validation, vendor mapping, regional configuration, GPC handling, Consent Mode, TCF support where applicable and documentation.</p></div></div></section>

  <ServiceCTA title="Build a Consent System You Can Actually Trust" detail="Your CMP should capture privacy choices, communicate them to the technology stack, and make analytics and advertising systems behave according to the approved consent model. Upsight designs, implements and validates that technical consent layer. Technical implementation support, not legal advice." primaryLabel="Review My Consent Setup" secondaryLabel="Book a Consultation" secondaryHref="/contact/" />
</BaseLayout>
