---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import DashboardHeroPreview from '../../components/services/DashboardHeroPreview.astro';
import DashboardDemo from '../../components/services/DashboardDemo.astro';
import ServiceProofCard from '../../components/services/ServiceProofCard.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import { serviceSchema } from '../../lib/seo';
import '../../styles/dashboard.css';

const capabilities = [
  ['Measurement & KPI Design','KPI definitions, business logic, attribution context, currency and market definitions, and stakeholder requirements.'],
  ['Data Integration','Analytics, advertising platforms, ecommerce, CRM and business systems, warehouses, and approved APIs.'],
  ['Reporting Architecture','Transformation logic, calculated metrics, data models, BigQuery or Snowflake where appropriate, and reusable reporting layers.'],
  ['Dashboard Experience','Executive and marketing views, market and channel filters, drill-downs, scheduled reporting, documentation, and access governance.'],
];
const technologies = [
  ['Google Data Studio','/images/tech/looker-studio.svg','Interactive reporting and stakeholder dashboards.'],
  ['BigQuery','/images/tech/bigquery.svg','Cloud analytics warehouse and scalable reporting datasets.'],
  ['Power BI','/images/tech/power-bi.svg','Enterprise reporting and business intelligence.'],
  ['Snowflake','/images/tech/snowflake.svg','Cloud data platform and governed reporting datasets.'],
  ['Amazon Marketing Cloud','/images/tech/amazon-marketing-cloud.png','Privacy-safe advertising analysis and custom measurement workflows within the Amazon Ads ecosystem.'],
];
const faqs = [
  ['Can you combine GA4 and advertising data?','Yes. We can combine approved data sources into a shared reporting layer, provided the required access, identifiers and source data are available.'],
  ['Do we need BigQuery?','No. BigQuery is useful when reporting needs scalable storage, transformations or more control than direct connectors provide, but many dashboards do not require it.'],
  ['Can the dashboard connect to ecommerce data?','Yes. We can integrate ecommerce data where the platform provides an appropriate connector, API, database or export method.'],
  ['Will the dashboard update in real time?','No. Refresh frequency depends on source systems, connectors and reporting architecture; we define an appropriate freshness expectation instead.'],
  ['Can different teams have different dashboard views?','Yes. Dashboards can be designed around stakeholder requirements, permissions and levels of detail.'],
  ['Can you build Power BI dashboards?','Yes. Power BI is part of the reporting stack Upsight can work with where it fits the client environment and reporting requirements.'],
  ['Can you work with Snowflake?','Yes. Snowflake can act as a governed source and reporting layer where the client architecture uses it or the requirements justify it.'],
  ['Can you work with Amazon Marketing Cloud?','Yes. We can work with Amazon Marketing Cloud for eligible Amazon Ads analysis and measurement use cases, then incorporate relevant outputs into the broader reporting architecture where appropriate.'],
  ['Should we fix tracking before building a dashboard?','Yes. Material source-tracking problems should be corrected or clearly documented before stakeholders rely on downstream reporting.'],
];
---
<BaseLayout title="Analytics Dashboards & Reporting | Upsight Digital" description="Build decision-focused analytics dashboards with defined KPIs, connected data sources, validated metrics, stakeholder controls, and reporting governance." jsonLd={serviceSchema('Analytics Dashboards & Reporting', 'Decision-focused analytics dashboards with KPI definitions, connected data sources, validated metrics, stakeholder controls, and reporting governance.', '/services/analytics-dashboards/')}>
  <ServiceHero eyebrow="REPORTING & DECISION SUPPORT" title="Analytics Dashboards Built Around Decisions" lead="Bring marketing, ecommerce and business performance into reporting your teams can actually use." detail="Upsight combines the right KPIs, data sources and reporting logic into dashboards built for the people making decisions, from marketing teams to leadership." primaryLabel="Discuss My Reporting Needs"><DashboardHeroPreview slot="visual" /></ServiceHero>

  <div class="container py-10 md:py-16"><DashboardDemo /></div>

  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><div class="grid gap-6 lg:grid-cols-[.8fr_1.2fr]"><div><p class="service-kicker">REPORTING FOUNDATION</p><h2 class="service-heading mt-3">From Raw Data to Decision-Ready Reporting</h2></div><p class="leading-7 text-muted-foreground">A dashboard is only as useful as the definitions and data behind it. Upsight starts by defining what each KPI means, identifying the system that owns it, and validating how the metric should be calculated before it reaches the reporting layer.</p></div><ol class="reporting-process mt-8" aria-label="Reporting process">{['Business Questions','KPI Definitions','Data Sources','Transformation','Validation','Dashboard'].map((step, index) => <li><span>{index + 1}</span><strong>{step}</strong></li>)}</ol></div></section>

  <section class="py-12 md:py-16"><div class="container"><p class="service-kicker">WHAT UPSIGHT BUILDS</p><h2 class="service-heading mt-3">From metric design to stakeholder views</h2><div class="mt-7 grid gap-4 md:grid-cols-2">{capabilities.map(([title, detail]) => <article class="service-proof-card"><h3>{title}</h3><p>{detail}</p></article>)}</div></div></section>

  <section class="bg-muted/30 py-12 md:py-16" data-testid="reporting-platforms"><div class="container"><p class="service-kicker">TECHNOLOGY</p><h2 class="service-heading mt-3">Reporting &amp; Data Platforms</h2><p class="mt-4 max-w-3xl leading-7 text-muted-foreground">We work across reporting tools, cloud warehouses and advertising clean-room environments depending on the data, scale and decisions the dashboard needs to support.</p><div class="technology-grid mt-7">{technologies.map(([name, logo, detail]) => <article class="technology-card"><img src={logo} alt={`${name} logo`} loading="lazy" width="72" height="72"/><div><h3>{name}</h3><p>{detail}</p></div></article>)}</div></div></section>

  <section class="py-12 md:py-16"><div class="container max-w-5xl"><p class="service-kicker">RELEVANT PROOF</p><h2 class="service-heading mt-3">Measurement foundations that support better reporting</h2><div class="mt-7"><ServiceProofCard title="Roadsurfer measurement foundation" detail="See the approved Roadsurfer case study for GA4 implementation, tracking rebuild and data-consolidation context that can support downstream reporting." href="/case-studies/roadsurfer/" label="Read the Roadsurfer case study" /></div><p class="mt-4 text-sm text-muted-foreground">The dashboard interface above uses illustrative demo data and is not client reporting or proof of client outcomes.</p></div></section>

  <section class="bg-muted/30 py-12 md:py-16"><div class="container max-w-4xl"><p class="service-kicker">FAQ</p><h2 class="service-heading mt-3">Analytics dashboard questions</h2><div class="mt-6 space-y-3" data-dashboard-faq>{faqs.map(([question, answer]) => <details class="rounded border border-border p-4"><summary class="cursor-pointer font-semibold">{question}</summary><p class="mt-3 text-sm leading-6 text-muted-foreground">{answer}</p></details>)}</div></div></section>

  <ServiceCTA title="Turn Trusted Measurement Into Reporting People Can Use" detail="Start with the decisions, metrics and source systems your stakeholders need to understand." primaryLabel="Discuss My Reporting Needs" />
</BaseLayout>
