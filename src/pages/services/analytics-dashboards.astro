---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import DashboardDemo from '../../components/services/DashboardDemo.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import { serviceSchema } from '../../lib/seo';
const capabilities = [['KPI definition','Metric definitions, business logic, numerator/denominator, currency, and attribution context.'],['Source mapping','GA4, advertising platforms, commerce systems, CRM, spreadsheets, and approved APIs.'],['Data modelling','Joins, calculated fields, transformations, and BigQuery where justified.'],['Dashboard design','Stakeholder views, filters, date ranges, drill-downs, and information hierarchy.'],['QA','Source reconciliation, filter behaviour, date handling, freshness, and permissions.']];
const faqs = [['Can you combine GA4 and advertising data?','We scope integrations around access, connector constraints, data quality, and agreed metric definitions.'],['Do we need BigQuery?','Not necessarily. It depends on the source systems, transformations, data volume, and reporting requirement.'],['Can the dashboard connect to ecommerce data?','Yes, where the commerce data and agreed source connection are available.'],['How often will the data refresh?','Freshness depends on the connected source and reporting design, so it is agreed rather than assumed.'],['Can different teams have different views?','Yes. Stakeholder views can be designed around their decisions while preserving shared metric definitions.'],['What happens when source tracking changes?','The reporting layer needs governance and validation whenever source or business logic changes.'],['Should we fix tracking before building a dashboard?','When input measurement is unreliable, an audit or implementation should normally come first.']];
---
<BaseLayout title="Analytics Dashboards & Reporting | Upsight Digital" description="Build decision-focused analytics dashboards with defined KPIs, connected data sources, validated metrics, stakeholder controls, and reporting governance." jsonLd={serviceSchema('Analytics Dashboards & Reporting', 'Decision-focused analytics dashboards with KPI definitions, connected data sources, validated metrics, stakeholder controls, and reporting governance.', '/services/analytics-dashboards/')}>
  <ServiceHero eyebrow="REPORTING & DECISION SUPPORT" title="Analytics Dashboards Built Around Decisions" lead="Bring marketing, ecommerce and business performance into reporting that people can actually use." detail="Upsight defines the KPIs, maps the source systems, builds the reporting layer and validates the numbers before turning them into stakeholder-ready dashboards." primaryLabel="Discuss My Reporting Needs"><div slot="visual" class="grid grid-cols-2 gap-2 text-sm"><p class="service-kicker col-span-2">DASHBOARD PREVIEW</p>{[['Revenue','AED 184k'],['Orders','612'],['Conversion Rate','2.8%'],['ROAS','3.37x']].map(([label,value]) => <div class="rounded border border-border bg-background/50 p-2"><small class="block text-muted-foreground">{label}</small><strong class="text-primary">{value}</strong></div>)}<svg class="col-span-2 mt-2 h-16 w-full" viewBox="0 0 220 50" role="img" aria-label="Illustrative trend line"><polyline points="2,42 35,32 68,36 101,18 134,26 167,8 218,15" fill="none" stroke="#23c99d" stroke-width="3" /></svg></div></ServiceHero>
  <div class="container py-10 md:py-16"><DashboardDemo /></div>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container grid gap-8 lg:grid-cols-[.8fr_1.2fr]"><div><p class="service-kicker">BEFORE VISUALIZATION</p><h2 class="service-heading mt-3">A Better Dashboard Starts Before the Dashboard</h2></div><div><p class="leading-7 text-muted-foreground">A dashboard cannot make unreliable data trustworthy. Before we design charts, we define what each KPI means, which system owns it, how it is calculated, how fresh it should be, and what differences stakeholders should expect between platforms.</p><p class="service-flow-line mt-6">Business Question ↓ KPI Definition ↓ Source System ↓ Transformation ↓ Validation ↓ Dashboard</p></div></div></section>
  <section class="py-12 md:py-16"><div class="container"><p class="service-kicker">SOURCE ARCHITECTURE</p><h2 class="service-heading mt-3">A reporting layer needs an understood input path</h2><div class="service-panel mt-6 text-center font-mono text-sm leading-8"><p>GA4 · Google Ads · Meta · Ecommerce · CRM · Other approved sources</p><p class="text-primary">↓</p><p>Data preparation / BigQuery / connectors</p><p class="text-primary">↓</p><p>Google Data Studio / reporting layer</p><p class="text-primary">↓</p><p>Marketing · Leadership · Analytics · Operations</p></div><p class="mt-4 text-sm text-muted-foreground">Architecture depends on data volume, source systems, transformation needs and reporting requirements. Not every dashboard needs BigQuery.</p></div></section>
  <section class="bg-muted/30 py-12 md:py-16"><div class="container"><p class="service-kicker">REPORTING FOUNDATION</p><h2 class="service-heading mt-3">What Upsight Does Before Visualization</h2><div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{capabilities.map(([title,detail]) => <article class="service-proof-card"><h3>{title}</h3><p>{detail}</p></article>)}</div><div class="mt-8 grid gap-4 sm:grid-cols-2 md:grid-cols-4">{['Google Data Studio (formerly Looker Studio)','BigQuery','Google Analytics 4','Google Ads'].map(tool => <div class="rounded-xl border border-border bg-background/50 p-4 text-center text-sm font-semibold">{tool}</div>)}</div></div></section>
  <section class="py-12 md:py-16"><div class="container max-w-4xl"><h2 class="service-heading">Reporting questions</h2><div class="mt-5 space-y-3">{faqs.map(([q,a]) => <details class="rounded border border-border p-4"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-3 text-sm leading-6 text-muted-foreground">{a}</p></details>)}</div><p class="mt-6 text-sm">A reporting layer cannot repair unreliable inputs. Start with a <a class="text-primary underline" href="/services/tracking-audit/">Tracking Audit</a>, <a class="text-primary underline" href="/services/ga4-gtm-setup/">GA4 &amp; GTM</a>, or <a class="text-primary underline" href="/services/ecommerce-tracking/">Ecommerce Tracking</a> where appropriate. See the approved <a class="text-primary underline" href="/case-studies/roadsurfer/">Roadsurfer case study</a> for measurement-foundation context.</p></div></section>
  <ServiceCTA title="Turn Trusted Measurement Into Reporting People Can Use" detail="Start with the decisions, metrics, and source systems your stakeholders need to understand." primaryLabel="Discuss My Reporting Needs" secondaryLabel="Review My Tracking First" secondaryHref="/services/tracking-audit/" />
</BaseLayout>
