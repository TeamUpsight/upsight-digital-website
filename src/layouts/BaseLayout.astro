---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { organizationSchema, publicPageUrl, websiteSchema } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  hideShell?: boolean;
}

const {
  title,
  description,
  canonical: canonicalProp,
  ogImage = 'https://upsight.digital/images/hero_analytics_abstract.webp',
  ogType = 'website',
  jsonLd,
  noindex = false,
  hideShell = false,
} = Astro.props;

const canonical = publicPageUrl(canonicalProp ?? Astro.url.pathname);

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbLabels: Record<string, string> = {
  services: 'Services',
  'cookie-consent': 'Cookie Consent & CMP',
  'who-its-for': "Who It's For",
  process: 'Process',
  about: 'About',
  contact: 'Contact',
  'health-check': 'Analytics Health Check',
  'case-studies': 'Case Studies',
  slice: 'Slice Case Study',
  roadsurfer: 'Roadsurfer Case Study',
};

const breadcrumbSchema = pathSegments.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: publicPageUrl() },
        ...pathSegments.map((segment, index) => ({
          '@type': 'ListItem',
          position: index + 2,
          name: breadcrumbLabels[segment] ?? segment.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
          item: publicPageUrl(`/${pathSegments.slice(0, index + 1).join('/')}/`),
        })),
      ],
    }
  : undefined;

const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = [
  organizationSchema,
  websiteSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...pageSchemas,
];

const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#14171f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Upsight Digital" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="Upsight Digital analytics consultancy" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {structuredData.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}

    <!-- Google Tag Manager. Kept asynchronous to preserve measurement coverage. -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-T737M5FZ');</script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:text-primary">Skip to main content</a>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T737M5FZ" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    {!hideShell && <Navigation />}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {!hideShell && <Footer />}
    <script is:inline>
      window.addEventListener('load', () => {
        window.setTimeout(() => {
          const script = document.createElement('script');
          script.src = '/adblocker-detector.js';
          script.async = true;
          document.head.appendChild(script);
        }, 8000);
      }, { once: true });
    </script>
  </body>
</html>
