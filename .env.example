# Local development only. Copy this file to `.env` and add your real key.
# Never commit `.env` to Git.
RESEND_API_KEY=re_your_key_

# Public widget key is embedded at BUILD time. Production must use your own key.
PUBLIC_TURNSTILE_SITE_KEY=
# Server-only Cloudflare Worker secret. Never prefix this with PUBLIC_.
TURNSTILE_SECRET_KEY=
# Optional local-only bypass: true works only in Astro development on loopback.
# Leave PUBLIC_TURNSTILE_SITE_KEY blank when using the local bypass.
TURNSTILE_LOCAL_BYPASS=false
